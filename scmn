#!/usr/bin/env bash
#
# scmn - Simple Screen Service Manager
# -----------------------------------------------------------------------------
# Manages background services using GNU Screen sessions.
# Supports automatic restarts, process attachment, logging, input sending, and cron monitoring.
#

set -euo pipefail

# Application version
VERSION="v0.8.0"

# Ensure SCREENDIR is set and safe (prevents permission issues on some Linux setups)
if [[ -z "${SCREENDIR:-}" ]]; then
    export SCREENDIR="$HOME/.screen"
fi
if [[ ! -d "$SCREENDIR" ]]; then
    mkdir -p "$SCREENDIR"
    chmod 700 "$SCREENDIR"
fi

# State directory for tracking service configuration signatures (used by reload)
get_state_dir() {
    local statedir="${SCMN_STATE_DIR:-$HOME/.config/scmn/.state}"
    if ! mkdir -p "$statedir" 2>/dev/null; then
        statedir="/tmp/scmn_state_${UID:-0}"
        mkdir -p "$statedir" 2>/dev/null || true
    fi
    echo "$statedir"
}

# Configuration locations (checked in order)
DEFAULT_CONFIG_LOCATIONS=(
    "${SCMN_CONF:-}"
    "./scmn.conf"
    "$HOME/.config/scmn/scmn.conf"
    "/etc/scmn/scmn.conf"
)

CONFIG_FILE=""

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Helper output functions
log_info()    { echo -e "${CYAN}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

# Central event log file (only logs actual actions & state changes, not routine checks)
SCMN_LOG="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"

log_event() {
    local level="$1"
    local msg="$2"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    local logdir
    logdir=$(dirname "$SCMN_LOG")
    if [[ ! -d "$logdir" ]]; then
        mkdir -p "$logdir" 2>/dev/null || true
    fi

    echo "[$timestamp] [$level] $msg" >> "$SCMN_LOG" 2>/dev/null || true
}

find_config() {
    for loc in "${DEFAULT_CONFIG_LOCATIONS[@]}"; do
        if [[ -n "$loc" && -f "$loc" ]]; then
            CONFIG_FILE="$loc"
            return 0
        fi
    done
    return 1
}

ensure_config() {
    if ! find_config; then
        log_error "No configuration file found!"
        log_info "Searched locations:"
        for loc in "./scmn.conf" "$HOME/.config/scmn/scmn.conf" "/etc/scmn/scmn.conf"; do
            echo "  - $loc"
        done
        echo
        log_info "Create a file with format:"
        echo "  # Format: shortname|directory|command|logfile|env|auto_restart"
        echo "  webserver|/var/www/app|python3 -m http.server \$PORT|/var/log/web.log|PORT=8080|true"
        echo "  bot|/home/user/bot|node index.js|none|-|false"
        exit 1
    fi
}

# Checks if screen session with exact shortname is running
is_running() {
    local name="$1"
    # screen -ls outputs lines like: '\t12345.shortname\t(Detached)'
    if screen -ls 2>/dev/null | grep -E -q "\.[0-9A-Za-z_-]*${name}\b"; then
        return 0
    fi
    return 1
}

# Helper: Get PID of a screen session by shortname
get_session_pid() {
    local name="$1"
    screen -ls 2>/dev/null | grep -E "\.[0-9A-Za-z_-]*${name}\b" | awk '{print $1}' | cut -d'.' -f1 | head -n 1
}

# Helper: Check service runtime state ("RUNNING", "RESTARTING", or "STOPPED")
get_service_state() {
    local name="$1"
    local cmd="${2:-}"

    if ! is_running "$name"; then
        echo "STOPPED"
        return 0
    fi

    local screen_pid
    screen_pid=$(get_session_pid "$name")
    if [[ -z "$screen_pid" ]]; then
        echo "STOPPED"
        return 0
    fi

    local wrapper_pid
    wrapper_pid=$(pgrep -P "$screen_pid" 2>/dev/null | head -n 1 || true)

    if [[ -n "$wrapper_pid" ]]; then
        local child_pids
        child_pids=$(pgrep -P "$wrapper_pid" 2>/dev/null || true)

        if [[ -n "$child_pids" ]]; then
            local child_comms
            child_comms=$(ps -o comm= -p $child_pids 2>/dev/null | xargs || true)

            # If child process is 'sleep' and command is not a sleep command, service is in restart cooldown
            if [[ "$child_comms" == *"sleep"* ]] && [[ "$cmd" != sleep* ]]; then
                echo "RESTARTING"
                return 0
            fi
        fi
    fi

    echo "RUNNING"
}

# Start a specific service from config definition
start_service() {
    local name="$1"
    local dir="$2"
    local cmd="$3"
    local logfile="${4:-none}"
    local env_vars="${5:-none}"
    local auto_restart="${6:-false}"

    if is_running "$name"; then
        log_info "Service '$name' is already running."
        return 0
    fi

    # Trim fields
    name=$(echo "$name" | xargs)
    dir=$(echo "$dir" | xargs)
    cmd=$(echo "$cmd" | xargs)
    logfile=$(echo "$logfile" | xargs)
    env_vars=$(echo "$env_vars" | xargs)
    auto_restart=$(echo "$auto_restart" | xargs)

    # Validate directory
    if [[ -n "$dir" && "$dir" != "-" ]]; then
        if [[ ! -d "$dir" ]]; then
            log_error "Directory '$dir' for service '$name' does not exist!"
            return 1
        fi
    fi

    # Build screen command
    local screen_args=(-dmS "$name")

    # Logging options
    if [[ -n "$logfile" && "$logfile" != "none" && "$logfile" != "off" && "$logfile" != "-" ]]; then
        local logdir
        logdir=$(dirname "$logfile")
        if [[ ! -d "$logdir" ]]; then
            mkdir -p "$logdir" 2>/dev/null || true
        fi
        screen_args+=(-L -Logfile "$logfile")
    fi

    # Prepare execution wrapper with env vars and auto-restart loop if enabled
    local exec_cmd=""

    if [[ -n "$env_vars" && "$env_vars" != "none" && "$env_vars" != "-" ]]; then
        exec_cmd="export $env_vars; "
    fi

    local restart_mode="never"
    case "$(echo "$auto_restart" | tr '[:upper:]' '[:lower:]')" in
        on-failure|on_failure|failure|fail)
            restart_mode="on-failure"
            ;;
        true|yes|1|always)
            restart_mode="always"
            ;;
        *)
            restart_mode="never"
            ;;
    esac

    if [[ "$restart_mode" == "always" ]]; then
        exec_cmd="${exec_cmd}while true; do $cmd; echo '[scmn] Process exited. Restarting in 2s...'; sleep 2; done"
    elif [[ "$restart_mode" == "on-failure" ]]; then
        exec_cmd="${exec_cmd}while true; do $cmd; _code=\$?; if [ \$_code -eq 0 ]; then echo '[scmn] Process exited cleanly (exit code 0). Stopping.'; break; fi; echo \"[scmn] Process failed (exit code \$_code). Restarting in 2s...\"; sleep 2; done"
    else
        exec_cmd="${exec_cmd}$cmd"
    fi

    # Launch in specified directory if present
    if [[ -n "$dir" && "$dir" != "-" ]]; then
        (
            cd "$dir"
            screen "${screen_args[@]}" bash -c "$exec_cmd"
        )
    else
        screen "${screen_args[@]}" bash -c "$exec_cmd"
    fi

    sleep 0.4
    local initial_state
    initial_state=$(get_service_state "$name" "$cmd")

    if [[ "$initial_state" == "RUNNING" ]]; then
        local statedir
        statedir=$(get_state_dir)
        echo "${dir}|${cmd}|${logfile}|${env_vars}|${auto_restart}" > "$statedir/$name.state" 2>/dev/null || true
        log_success "Started service '$name' (Command: $cmd)"
        log_event "OK" "Started service '$name' (Command: $cmd)"
    elif [[ "$initial_state" == "RESTARTING" ]]; then
        local statedir
        statedir=$(get_state_dir)
        echo "${dir}|${cmd}|${logfile}|${env_vars}|${auto_restart}" > "$statedir/$name.state" 2>/dev/null || true
        log_warn "Started session for '$name', but command failed/is restarting (Command: $cmd)"
        log_event "WARN" "Started session for '$name', but command failed/is restarting (Command: $cmd)"
    elif is_running "$name"; then
        local statedir
        statedir=$(get_state_dir)
        echo "${dir}|${cmd}|${logfile}|${env_vars}|${auto_restart}" > "$statedir/$name.state" 2>/dev/null || true
        log_success "Started service '$name' (Command: $cmd)"
        log_event "OK" "Started service '$name' (Command: $cmd)"
    else
        log_error "Failed to start service '$name'."
        log_event "ERROR" "Failed to start service '$name'."
        return 1
    fi
}

# Max log size in MB before truncation (default: 50MB)
MAX_LOG_SIZE_MB="${MAX_LOG_SIZE_MB:-50}"

# Truncates a logfile in-place if it exceeds MAX_LOG_SIZE_MB
truncate_log_if_needed() {
    local name="$1"
    local logfile="$2"

    if [[ -z "$logfile" || "$logfile" == "none" || "$logfile" == "off" || "$logfile" == "-" ]]; then
        return 0
    fi

    if [[ ! -f "$logfile" ]]; then
        return 0
    fi

    local max_bytes=$((MAX_LOG_SIZE_MB * 1024 * 1024))
    local current_size
    current_size=$(stat -c%s "$logfile" 2>/dev/null || echo 0)

    if (( current_size > max_bytes )); then
        local size_mb=$((current_size / 1024 / 1024))
        log_warn "Log file for '$name' ($logfile) exceeds limit: ${size_mb}MB / ${MAX_LOG_SIZE_MB}MB. Truncating..."

        local temp_tail
        temp_tail=$(mktemp)

        # Retain last 25MB (half of max limit) so log grows from 25MB up to 50MB again
        local keep_bytes=$((max_bytes / 2))
        tail -c "$keep_bytes" "$logfile" > "$temp_tail" 2>/dev/null || true
        cat "$temp_tail" > "$logfile" 2>/dev/null || true
        rm -f "$temp_tail"

        log_success "Truncated '$logfile' to last $((keep_bytes / 1024 / 1024))MB."
        log_event "WARN" "Truncated log file '$logfile' for service '$name' (${size_mb}MB -> $((keep_bytes / 1024 / 1024))MB)."
    fi
}

# Parse config file and execute callback function for each valid service
# Callback format: fn "name" "dir" "cmd" "logfile" "env" "auto_restart" [is_disabled]
parse_config() {
    local callback="$1"
    local include_disabled="${2:-false}"

    ensure_config

    local line_num=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_num=$((line_num + 1))

        # Strip leading/trailing whitespace
        local trimmed_line
        trimmed_line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        # Ignore empty lines
        if [[ -z "$trimmed_line" ]]; then
            continue
        fi

        local is_comment=false
        if [[ "$trimmed_line" =~ ^# ]]; then
            is_comment=true
        fi

        if $is_comment && [[ "$include_disabled" != "true" ]]; then
            continue
        fi

        local parse_line="$trimmed_line"
        local is_disabled="false"
        if $is_comment; then
            # Strip leading # and whitespace
            parse_line="$(echo "$trimmed_line" | sed -e 's/^#[[:space:]]*//')"
            is_disabled="true"
        fi

        # Check if line contains pipe delimiter
        if [[ "$parse_line" != *"|"* ]]; then
            continue
        fi

        # Parse pipe-separated values: shortname|directory|command|logfile|env|auto_restart
        local name="" dir="" cmd="" logfile="" env_vars="" auto_restart=""
        IFS='|' read -r name dir cmd logfile env_vars auto_restart <<< "$parse_line"

        name=$(echo "${name:-}" | xargs)
        dir=$(echo "${dir:-}" | xargs)
        cmd=$(echo "${cmd:-}" | xargs)
        logfile=$(echo "${logfile:-}" | xargs)
        env_vars=$(echo "${env_vars:-}" | xargs)
        auto_restart=$(echo "${auto_restart:-}" | xargs)

        # Validate name and command
        if [[ -z "$name" || -z "$cmd" ]]; then
            if ! $is_comment; then
                log_warn "Line $line_num in '$CONFIG_FILE' missing shortname or command: $line"
            fi
            continue
        fi

        # Filter out header comments that might contain pipes
        if [[ "$name" =~ ^(shortname|Format|Format:|Rules:|Rules)$ ]] || [[ ! "$name" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
            continue
        fi

        "$callback" "$name" "$dir" "$cmd" "$logfile" "$env_vars" "$auto_restart" "$is_disabled" || true
    done < "$CONFIG_FILE"
}

## Command: Start missing services (all or single target) + truncate logs
cmd_start() {
    local target="${1:-}"
    #find_config
    ensure_config
    log_info "Using configuration: ${CONFIG_FILE}"

    if [[ -n "$target" && "$target" != "--all" ]]; then
        log_info "Checking and starting target service '$target'..."
        echo
        local found=false

        start_single_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"
            local env_vars="$5"
            local auto_restart="$6"
            local is_disabled="${7:-false}"

            if [[ "$name" == "$target" ]]; then
                found=true
                if [[ "$is_disabled" == "true" ]]; then
                    log_warn "Service '$target' is disabled in configuration. Use 'scmn enable $target --now' to enable and start it."
                    return 0
                fi
                start_service "$name" "$dir" "$cmd" "$logfile" "$env_vars" "$auto_restart"
                truncate_log_if_needed "$name" "$logfile"
            fi
        }

        parse_config start_single_callback "true"

        if ! $found; then
            log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
            exit 1
        fi
    else
        log_info "Checking and starting missing services..."
        echo

        parse_config start_service

        echo
        log_info "Checking log file sizes (Limit: ${MAX_LOG_SIZE_MB}MB)..."

        check_logs_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"

            truncate_log_if_needed "$name" "$logfile"
        }

        parse_config check_logs_callback
    fi
}


format_uptime() {
    local etime="$1"
    local days=0 h=0 m=0 s=0

    case "$etime" in
        *-*)
            days=${etime%%-*}
            IFS=: read -r h m s <<< "${etime#*-}"
            ;;
        *:*:*)
            IFS=: read -r h m s <<< "$etime"
            ;;
        *:*)
            IFS=: read -r m s <<< "$etime"
            ;;
    esac

    #local total=$((days*86400 + h*3600 + m*60 + s))
    local total=$((10#$days*86400 + 10#$h*3600 + 10#$m*60 + 10#$s))

    if (( total < 48*3600 )); then
        printf "%02d:%02d:%02d\n" $((total/3600)) $(((total%3600)/60)) $((total%60))

    elif (( total < 365*86400 )); then
        printf "%dd %dh\n" $((total/86400)) $(((total%86400)/3600))

    else
        printf "%dy %dd\n" $((total/31536000)) $(((total%31536000)/86400))
    fi
}

# Command: List status of all configured services with metrics
cmd_status() {
    ensure_config
    log_info "Configuration file: ${CONFIG_FILE}"
    echo
    printf "${BOLD}%-14s %-10s %-7s %-6s %-10s %-10s %-27s %s${NC}\n" \
        "SHORTNAME" "STATUS" "PID" "RAM" "UPTIME" "RESTART" "COMMAND" "LOGFILE"
    printf "%s\n" "--------------------------------------------------------------------------------------------------------------------------"

    status_callback() {
        local name="$1"
        local dir="${2:-.}"
        local cmd="$3"
        local logfile="${4:-none}"
        local env_vars="${5:-none}"
        local auto_restart="${6:-false}"
        local is_disabled="${7:-false}"

        local status_colored=""
        local pid_str="-"
        local ram_str="-"
        local uptime_str="-"

        if [[ "$is_disabled" == "true" ]]; then
            if is_running "$name"; then
                # Disabled in config, but session still actively running
                status_colored="${YELLOW}DISABLED*${NC} "
                local main_pid
                main_pid=$(get_session_pid "$name")
                if [[ -n "$main_pid" ]]; then
                    local child_pid
                    child_pid=$(pgrep -P "$main_pid" 2>/dev/null | head -n 1 || true)
                    local target_pid="${child_pid:-$main_pid}"
                    pid_str="$target_pid"

                    local rss
                    rss=$(ps -p "$target_pid" -o rss= 2>/dev/null | xargs || echo 0)
                    if [[ -n "$rss" && "$rss" -gt 0 ]]; then
                        ram_str="$((rss / 1024))MB"
                    fi

                    uptime_str=$(ps -p "$target_pid" -o etime= 2>/dev/null | xargs || echo "-")
                    if [[ -n "$uptime_str" && "$uptime_str" != "-" ]]; then
                        uptime_str=$(format_uptime "$uptime_str")
                    else
                        uptime_str="-"
                    fi
                fi
            else
                # Visible width: 10 chars ("DISABLED" + 2 spaces)
                status_colored="${GRAY}DISABLED${NC}  "
            fi
        else
            local state
            state=$(get_service_state "$name" "$cmd")

            if [[ "$state" == "RUNNING" ]]; then
                # Visible width: 10 chars ("RUNNING" + 3 spaces)
                status_colored="${GREEN}RUNNING${NC}   "
                local main_pid
                main_pid=$(get_session_pid "$name")
                if [[ -n "$main_pid" ]]; then
                    local child_pid
                    child_pid=$(pgrep -P "$main_pid" 2>/dev/null | head -n 1 || true)
                    local target_pid="${child_pid:-$main_pid}"
                    pid_str="$target_pid"

                    local rss
                    rss=$(ps -p "$target_pid" -o rss= 2>/dev/null | xargs || echo 0)
                    if [[ -n "$rss" && "$rss" -gt 0 ]]; then
                        ram_str="$((rss / 1024))MB"
                    fi

                    uptime_str=$(ps -p "$target_pid" -o etime= 2>/dev/null | xargs || echo "-")
                    if [[ -n "$uptime_str" && "$uptime_str" != "-" ]]; then
                        uptime_str=$(format_uptime "$uptime_str")
                    else
                        uptime_str="-"
                    fi
                fi
            elif [[ "$state" == "RESTARTING" ]]; then
                # Visible width: 10 chars ("RESTARTING" + 0 spaces)
                status_colored="${YELLOW}RESTARTING${NC}"
                local main_pid
                main_pid=$(get_session_pid "$name")
                if [[ -n "$main_pid" ]]; then
                    pid_str="$main_pid"
                fi
            else
                # Visible width: 10 chars ("STOPPED" + 3 spaces)
                status_colored="${RED}STOPPED${NC}   "
            fi
        fi

        local restart_display="no"
        case "$(echo "$auto_restart" | tr '[:upper:]' '[:lower:]')" in
            on-failure|on_failure|failure|fail) restart_display="on-failure" ;;
            true|yes|1|always) restart_display="always" ;;
            *) restart_display="no" ;;
        esac

        printf "%-14s %b %-7s %-6s %-10s %-10s %-27s %s\n" \
            "${name:0:13}" \
            "$status_colored" \
            "${pid_str:0:6}" \
            "${ram_str:0:5}" \
            "${uptime_str:0:9}" \
            "${restart_display:0:13}" \
            "${cmd:0:27}" \
            "$logfile"
    }

    parse_config status_callback "true"
    echo

    log_info "Checking log file sizes (Limit: ${MAX_LOG_SIZE_MB}MB)..."

    check_logs_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        truncate_log_if_needed "$name" "$logfile"
    }

    parse_config check_logs_callback

}

# Stop a single service with graceful SIGTERM and force-kill SIGKILL fallback
stop_service_by_name() {
    local name="$1"

    if ! is_running "$name"; then
        log_warn "Service '$name' is not running."
        return 0
    fi

    local pid
    pid=$(get_session_pid "$name")

    # Step 1: Send graceful shutdown signal via screen quit (SIGTERM)
    screen -X -S "$name" quit 2>/dev/null || true

    # Step 2: Wait up to 2 seconds (10 steps of 0.2s) for clean termination
    local waited=0
    local max_wait=10
    while is_running "$name" && (( waited < max_wait )); do
        sleep 0.2
        waited=$((waited + 1))
    done

    # Step 3: Check if still running; if so, force kill (SIGKILL)
    if is_running "$name"; then
        log_warn "Service '$name' did not stop gracefully within 2s. Force killing (SIGKILL)..."
        log_event "WARN" "Service '$name' did not stop gracefully within 2s. Force killing (SIGKILL)."
        if [[ -n "$pid" ]]; then
            # Kill child processes inside screen session first, then screen itself
            pkill -9 -P "$pid" 2>/dev/null || true
            kill -9 "$pid" 2>/dev/null || true
        fi
        screen -wipe 2>/dev/null || true
        sleep 0.2
    fi

    if ! is_running "$name"; then
        local statedir
        statedir=$(get_state_dir)
        rm -f "$statedir/$name.state" 2>/dev/null || true
        log_success "Stopped service '$name'."
        log_event "OK" "Stopped service '$name'."
    else
        log_error "Failed to stop service '$name' even with SIGKILL."
        log_event "ERROR" "Failed to stop service '$name' even with SIGKILL."
    fi
}

# Command: Enable a disabled service in config (uncomment) and optionally start immediately (--now)
cmd_enable() {
    local target=""
    local now=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --now)
                now=true
                shift
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$target" ]]; then
        log_error "Please specify the service shortname to enable!"
        log_info "Usage: scmn enable <shortname> [--now]"
        exit 1
    fi

    ensure_config

    if [[ ! -w "$CONFIG_FILE" ]]; then
        log_error "Configuration file '$CONFIG_FILE' is not writable. Check permissions (or run with sudo)."
        exit 1
    fi

    local temp_file
    temp_file=$(mktemp "${CONFIG_FILE}.tmp.XXXXXX" 2>/dev/null || mktemp -t scmn_conf.XXXXXX)

    local found=false
    local already_enabled=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        local trimmed
        trimmed="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        # Check if active: ^target[[:space:]]*\|
        if [[ "$trimmed" =~ ^${target}[[:space:]]*\| ]]; then
            found=true
            already_enabled=true
            echo "$line" >> "$temp_file"
        # Check if commented/disabled: ^#[[:space:]]*target[[:space:]]*\|
        elif [[ "$trimmed" =~ ^#[[:space:]]*${target}[[:space:]]*\| ]]; then
            found=true
            # Remove leading '#' and optional space after '#'
            local uncommented
            uncommented="$(echo "$line" | sed -E 's/^([[:space:]]*)#[[:space:]]?/\1/')"
            echo "$uncommented" >> "$temp_file"
        else
            echo "$line" >> "$temp_file"
        fi
    done < "$CONFIG_FILE"

    if ! $found; then
        rm -f "$temp_file"
        log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
        exit 1
    fi

    if $already_enabled; then
        rm -f "$temp_file"
        log_warn "Service '$target' is already enabled in '${CONFIG_FILE}'."
        if $now; then
            cmd_start "$target"
        fi
        return 0
    fi

    mv "$temp_file" "$CONFIG_FILE"
    log_success "Enabled service '$target' in ${CONFIG_FILE}."
    log_event "OK" "Enabled service '$target' in ${CONFIG_FILE}."

    if $now; then
        log_info "Starting service '$target' (--now)..."
        cmd_start "$target"
    fi
}

# Command: Disable an enabled service in config (comment out) and optionally stop immediately (--now)
cmd_disable() {
    local target=""
    local now=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --now)
                now=true
                shift
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$target" ]]; then
        log_error "Please specify the service shortname to disable!"
        log_info "Usage: scmn disable <shortname> [--now]"
        exit 1
    fi

    ensure_config

    if [[ ! -w "$CONFIG_FILE" ]]; then
        log_error "Configuration file '$CONFIG_FILE' is not writable. Check permissions (or run with sudo)."
        exit 1
    fi

    local temp_file
    temp_file=$(mktemp "${CONFIG_FILE}.tmp.XXXXXX" 2>/dev/null || mktemp -t scmn_conf.XXXXXX)

    local found=false
    local already_disabled=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        local trimmed
        trimmed="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        # Check if disabled: ^#[[:space:]]*target[[:space:]]*\|
        if [[ "$trimmed" =~ ^#[[:space:]]*${target}[[:space:]]*\| ]]; then
            found=true
            already_disabled=true
            echo "$line" >> "$temp_file"
        # Check if active: ^target[[:space:]]*\|
        elif [[ "$trimmed" =~ ^${target}[[:space:]]*\| ]]; then
            found=true
            # Prefix with '# ' while preserving leading whitespace
            local commented
            commented="$(echo "$line" | sed -E 's/^([[:space:]]*)/\1# /')"
            echo "$commented" >> "$temp_file"
        else
            echo "$line" >> "$temp_file"
        fi
    done < "$CONFIG_FILE"

    if ! $found; then
        rm -f "$temp_file"
        log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
        exit 1
    fi

    if $already_disabled; then
        rm -f "$temp_file"
        log_warn "Service '$target' is already disabled in '${CONFIG_FILE}'."
        if $now && is_running "$target"; then
            stop_service_by_name "$target"
        fi
        return 0
    fi

    mv "$temp_file" "$CONFIG_FILE"
    log_success "Disabled service '$target' in ${CONFIG_FILE}."
    log_event "OK" "Disabled service '$target' in ${CONFIG_FILE}."

    if $now; then
        if is_running "$target"; then
            log_info "Stopping active service '$target' (--now)..."
            stop_service_by_name "$target"
        else
            log_info "Service '$target' is not currently running."
        fi
    fi
}

# Command: Attach to screen session
cmd_attach() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Please specify the service shortname to attach to!"
        log_info "Example: scmn attach webserver"
        exit 1
    fi

    if ! is_running "$target"; then
        log_error "No active screen session found for service '$target'."
        exit 1
    fi

    if [[ "${2:-}" == "attach" ]]; then
        log_info "Attaching to screen session '$target' (Detach with Ctrl+A followed by D)..."
        sleep 3
    fi

    exec screen -r "$target"
}

# Command: Send input / command directly to service stdin
cmd_send() {
    local target="${1:-}"
    shift || true
    local text="$*"

    if [[ -z "$target" || -z "$text" ]]; then
        log_error "Usage: scmn send <shortname> \"<command/text>\""
        log_info "Example: scmn send mc_server \"say Server restarting soon\""
        exit 1
    fi

    if ! is_running "$target"; then
        log_error "Service '$target' is not running."
        exit 1
    fi

    screen -S "$target" -X stuff "${text}$(printf '\r')"
    log_success "Sent input to service '$target': $text"
    log_event "INFO" "Sent input to service '$target': $text"
}

# Command: Stop a service or all services
cmd_stop() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Specify service shortname to stop, or '--all' to stop all."
        exit 1
    fi

    if [[ "$target" == "--all" ]]; then
        local stopped_any=false
        stop_all_callback() {
            local name="$1"
            if is_running "$name"; then
                stopped_any=true
                stop_service_by_name "$name"
            fi
        }
        parse_config stop_all_callback "true"

        if ! $stopped_any; then
            log_info "No active services to stop."
        fi
    else
        stop_service_by_name "$target"
    fi
}

# Command: Restart service(s)
cmd_restart() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Specify service shortname to restart, or '--all'."
        exit 1
    fi

    if [[ "$target" == "--all" ]]; then
        cmd_stop "--all"
        sleep 0.5
        cmd_start
    else
        local found=false
        restart_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"
            local env_vars="$5"
            local auto_restart="$6"
            local is_disabled="${7:-false}"

            if [[ "$name" == "$target" ]]; then
                found=true
                if [[ "$is_disabled" == "true" ]]; then
                    log_warn "Service '$target' is disabled in configuration. Use 'scmn enable $target --now' to enable and restart it."
                    if is_running "$target"; then
                        stop_service_by_name "$target"
                    fi
                    return 0
                fi
                cmd_stop "$target"
                sleep 0.5
                start_service "$name" "$dir" "$cmd" "$logfile" "$env_vars" "$auto_restart"
            fi
        }
        parse_config restart_callback "true"

        if ! $found; then
            log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
            exit 1
        fi
    fi
}

# Command: Synchronize running services with configuration file
cmd_reload() {
    ensure_config
    log_info "Using configuration: ${CONFIG_FILE}"
    log_info "Synchronizing services with configuration..."
    echo

    local -A configured_enabled=()
    local -A configured_disabled=()
    local -A service_dir=()
    local -A service_cmd=()
    local -A service_log=()
    local -A service_env=()
    local -A service_restart=()

    collect_services_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"
        local env_vars="$5"
        local auto_restart="$6"
        local is_disabled="${7:-false}"

        service_dir["$name"]="$dir"
        service_cmd["$name"]="$cmd"
        service_log["$name"]="$logfile"
        service_env["$name"]="$env_vars"
        service_restart["$name"]="$auto_restart"

        if [[ "$is_disabled" == "true" ]]; then
            configured_disabled["$name"]=1
        else
            configured_enabled["$name"]=1
        fi
    }

    parse_config collect_services_callback "true"

    local statedir
    statedir=$(get_state_dir)

    local stopped_count=0
    local restarted_count=0
    local started_count=0
    local unchanged_count=0

    # Step 1: Check running services
    for name in "${!service_cmd[@]}"; do
        if is_running "$name"; then
            if [[ -n "${configured_disabled[$name]:-}" ]]; then
                log_info "Stopping disabled service '$name'..."
                stop_service_by_name "$name"
                stopped_count=$((stopped_count + 1))
            elif [[ -n "${configured_enabled[$name]:-}" ]]; then
                local current_sig="${service_dir[$name]}|${service_cmd[$name]}|${service_log[$name]}|${service_env[$name]}|${service_restart[$name]}"
                local state_file="$statedir/$name.state"
                local old_sig=""
                if [[ -f "$state_file" ]]; then
                    old_sig=$(cat "$state_file" 2>/dev/null || true)
                fi

                if [[ -n "$old_sig" && "$old_sig" == "$current_sig" ]]; then
                    log_info "Service '$name' is up-to-date and running."
                    unchanged_count=$((unchanged_count + 1))
                else
                    log_info "Configuration changed for '$name'. Restarting..."
                    stop_service_by_name "$name"
                    sleep 0.3
                    start_service "$name" "${service_dir[$name]}" "${service_cmd[$name]}" "${service_log[$name]}" "${service_env[$name]}" "${service_restart[$name]}"
                    restarted_count=$((restarted_count + 1))
                fi
            fi
        fi
    done

    # Step 2: Start enabled services that are not running
    for name in "${!configured_enabled[@]}"; do
        if ! is_running "$name"; then
            log_info "Starting missing service '$name'..."
            start_service "$name" "${service_dir[$name]}" "${service_cmd[$name]}" "${service_log[$name]}" "${service_env[$name]}" "${service_restart[$name]}"
            started_count=$((started_count + 1))
        fi
    done

    echo
    log_info "Checking log file sizes (Limit: ${MAX_LOG_SIZE_MB}MB)..."
    check_logs_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        truncate_log_if_needed "$name" "$logfile"
    }
    parse_config check_logs_callback

    echo
    log_success "Reload completed (Started: $started_count, Restarted: $restarted_count, Stopped: $stopped_count, Unchanged: $unchanged_count)."
    log_event "OK" "Reloaded configuration from ${CONFIG_FILE} (Started: $started_count, Restarted: $restarted_count, Stopped: $stopped_count, Unchanged: $unchanged_count)."
}

# Command: Validate configuration file syntax and definitions
cmd_check() {
    ensure_config
    log_info "Checking configuration file: ${CONFIG_FILE}"
    echo

    local errors=()
    local warnings=()
    local enabled_count=0
    local disabled_count=0
    local -A seen_names=()
    local -A seen_lines=()

    local line_num=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_num=$((line_num + 1))

        local trimmed
        trimmed="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        if [[ -z "$trimmed" ]]; then
            continue
        fi

        local is_comment=false
        if [[ "$trimmed" =~ ^# ]]; then
            is_comment=true
        fi

        local parse_line="$trimmed"
        local is_disabled=false
        if $is_comment; then
            parse_line="$(echo "$trimmed" | sed -e 's/^#[[:space:]]*//')"
            is_disabled=true
        fi

        # Skip comments without pipe delimiter
        if [[ "$parse_line" != *"|"* ]]; then
            continue
        fi

        local name="" dir="" cmd="" logfile="" env_vars="" auto_restart=""
        IFS='|' read -r name dir cmd logfile env_vars auto_restart <<< "$parse_line"

        name=$(echo "${name:-}" | xargs)
        dir=$(echo "${dir:-}" | xargs)
        cmd=$(echo "${cmd:-}" | xargs)
        logfile=$(echo "${logfile:-}" | xargs)
        env_vars=$(echo "${env_vars:-}" | xargs)
        auto_restart=$(echo "${auto_restart:-}" | xargs)

        # Ignore known header comments
        if [[ "$name" =~ ^(shortname|Format|Format:|Rules:|Rules)$ ]]; then
            continue
        fi

        if $is_comment && [[ ! "$name" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
            continue
        fi

        # Shortname syntax check
        if [[ -z "$name" ]]; then
            errors+=("Line $line_num: Missing service shortname.")
            continue
        fi

        if [[ ! "$name" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
            errors+=("Line $line_num: Invalid shortname '$name'. Must contain only letters, numbers, underscores, dots, or hyphens.")
        fi

        # Duplicate shortname check
        if [[ -n "${seen_names[$name]:-}" ]]; then
            errors+=("Line $line_num: Duplicate service shortname '$name' (previously defined on line ${seen_lines[$name]}).")
        else
            seen_names["$name"]=1
            seen_lines["$name"]=$line_num
        fi

        if $is_disabled; then
            disabled_count=$((disabled_count + 1))
        else
            enabled_count=$((enabled_count + 1))
        fi

        # Command check
        if [[ -z "$cmd" ]]; then
            errors+=("Line $line_num: Service '$name' is missing a command.")
        else
            local primary_bin
            primary_bin=$(echo "$cmd" | awk '{print $1}')
            if [[ -n "$primary_bin" ]]; then
                if [[ "$primary_bin" == ./* || "$primary_bin" == /* ]]; then
                    if [[ ! -e "$primary_bin" ]]; then
                        warnings+=("Line $line_num: Executable '$primary_bin' for service '$name' not found on disk.")
                    fi
                elif ! command -v "$primary_bin" >/dev/null 2>&1; then
                    if ! type "$primary_bin" >/dev/null 2>&1; then
                        warnings+=("Line $line_num: Command '$primary_bin' for service '$name' not found in PATH.")
                    fi
                fi
            fi
        fi

        # Directory check
        if [[ -n "$dir" && "$dir" != "-" ]]; then
            if [[ ! -d "$dir" ]]; then
                warnings+=("Line $line_num: Working directory '$dir' for service '$name' does not exist.")
            fi
        fi

        # Logfile check
        if [[ -n "$logfile" && "$logfile" != "none" && "$logfile" != "off" && "$logfile" != "-" ]]; then
            local logdir
            logdir=$(dirname "$logfile")
            if [[ ! -d "$logdir" ]]; then
                if ! mkdir -p "$logdir" 2>/dev/null; then
                    warnings+=("Line $line_num: Log directory '$logdir' for service '$name' does not exist and cannot be created.")
                fi
            fi
        fi

        # Auto-restart policy check
        if [[ -n "$auto_restart" && "$auto_restart" != "-" ]]; then
            case "$(echo "$auto_restart" | tr '[:upper:]' '[:lower:]')" in
                always|true|1|yes|on-failure|on_failure|failure|fail|false|no|never|0)
                    ;;
                *)
                    warnings+=("Line $line_num: Unknown auto_restart policy '$auto_restart' for service '$name' (defaults to 'never').")
                    ;;
            esac
        fi

    done < "$CONFIG_FILE"

    # Display results
    if (( ${#errors[@]} > 0 )); then
        for err in "${errors[@]}"; do
            log_error "$err"
        done
    fi

    if (( ${#warnings[@]} > 0 )); then
        for warn in "${warnings[@]}"; do
            log_warn "$warn"
        done
    fi

    echo
    if (( ${#errors[@]} > 0 )); then
        log_error "Configuration check FAILED with ${#errors[@]} error(s) and ${#warnings[@]} warning(s)."
        return 1
    elif (( ${#warnings[@]} > 0 )); then
        log_warn "Configuration check PASSED with ${#warnings[@]} warning(s) ($enabled_count enabled, $disabled_count disabled service(s))."
        return 0
    else
        log_success "Configuration syntax is valid ($enabled_count enabled, $disabled_count disabled service(s))."
        return 0
    fi
}

# Command: Clear log file for a service, all services (--all), or scmn manager log (default)
cmd_log_clear() {
    local target="${1:-}"

    # Case 1: No target specified -> clear manager central log
    if [[ -z "$target" ]]; then
        local manager_log="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"
        if [[ ! -f "$manager_log" ]]; then
            log_info "Manager log file '$manager_log' does not exist yet (nothing to clear)."
            return 0
        fi

        : > "$manager_log" 2>/dev/null || true
        log_success "Cleared scmn manager log ($manager_log)."
        log_event "OK" "Cleared scmn manager log ($manager_log)."
        return 0
    fi

    # Case 2: --all specified -> clear all service log files and manager log
    if [[ "$target" == "--all" ]]; then
        ensure_config
        local cleared_count=0
        local seen_logs=()

        clear_all_logs_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"

            if [[ -n "$logfile" && "$logfile" != "none" && "$logfile" != "off" && "$logfile" != "-" ]]; then
                for seen in "${seen_logs[@]:-}"; do
                    if [[ "$seen" == "$logfile" ]]; then
                        return 0
                    fi
                done
                seen_logs+=("$logfile")

                if [[ -f "$logfile" ]]; then
                    : > "$logfile" 2>/dev/null || true
                    log_success "Cleared log for '$name' ($logfile)."
                    cleared_count=$((cleared_count + 1))
                fi
            fi
        }

        parse_config clear_all_logs_callback "true"

        local manager_log="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"
        if [[ -f "$manager_log" ]]; then
            : > "$manager_log" 2>/dev/null || true
            log_success "Cleared manager log ($manager_log)."
            cleared_count=$((cleared_count + 1))
        fi

        log_success "Cleared all log files ($cleared_count file(s))."
        log_event "OK" "Cleared all log files ($cleared_count file(s))."
        return 0
    fi

    # Case 3: Specific service shortname
    ensure_config
    local target_logfile=""
    local service_found=false

    find_target_logfile_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        if [[ "$name" == "$target" ]]; then
            service_found=true
            target_logfile="$logfile"
        fi
    }

    parse_config find_target_logfile_callback "true"

    if ! $service_found; then
        log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
        exit 1
    fi

    if [[ -z "$target_logfile" || "$target_logfile" == "none" || "$target_logfile" == "off" || "$target_logfile" == "-" ]]; then
        log_warn "Service '$target' does not have a log file configured."
        return 0
    fi

    if [[ ! -f "$target_logfile" ]]; then
        log_info "Log file '$target_logfile' for service '$target' does not exist yet (nothing to clear)."
        return 0
    fi

    : > "$target_logfile" 2>/dev/null || true
    log_success "Cleared log file '$target_logfile' for service '$target'."
    log_event "OK" "Cleared log file '$target_logfile' for service '$target'."
}

## Command: View logs for a service or the manager log if shortname is omitted
cmd_log() {
    local first="${1:-}"

    if [[ "$first" == "clear" || "$first" == "--clear" ]]; then
        shift || true
        cmd_log_clear "${1:-}"
        return 0
    fi

    local target="${1:-}"
    local lines="${2:-50}"

    # If shortname is omitted, tail the manager's central log file
    if [[ -z "$target" ]]; then
        local manager_log="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"
        if [[ ! -f "$manager_log" ]]; then
            log_warn "Manager log file '$manager_log' does not exist yet (no events logged)."
            exit 0
        fi

        log_info "Showing last $lines lines from scmn log ($manager_log):"
        echo "--------------------------------------------------------------------------------"
        tail -n "$lines" -f "$manager_log"
        return 0
    fi

    local target_logfile=""
    find_logfile_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        if [[ "$name" == "$target" ]]; then
            target_logfile="$logfile"
        fi
    }
    parse_config find_logfile_callback "true"

    if [[ -z "$target_logfile" || "$target_logfile" == "none" || "$target_logfile" == "off" ]]; then
        log_error "Service '$target' does not have a log file configured."
        exit 1
    fi

    if [[ ! -f "$target_logfile" ]]; then
        log_warn "Log file '$target_logfile' does not exist yet (no logs written)."
        exit 1
    fi

    log_info "Showing the last $lines lines from $target_logfile:"
    echo "--------------------------------------------------------------------------------"
    tail -n "$lines" -f "$target_logfile"
}

# Command: Cron job management (install/uninstall/status)
cmd_cron() {
    local subcmd="${1:-}"
    local script_path
    script_path=$(readlink -f "$0")

    local cron_comment="# scmn auto-check"
    local cron_schedule="*/15 * * * *"
    local cron_line="$cron_schedule SCMN_CONF=${CONFIG_FILE:-$HOME/.config/scmn/scmn.conf} $script_path start >/dev/null 2>&1 $cron_comment"

    case "$subcmd" in
        install)
            find_config || true
            local current_cron
            current_cron=$(crontab -l 2>/dev/null || true)

            if echo "$current_cron" | grep -q "$cron_comment"; then
                log_warn "scmn cron job is already installed."
                return 0
            fi

            (
                echo "$current_cron"
                echo "$cron_line"
            ) | crontab -

            log_success "Cron job installed! Runs every 15 minutes (*/15)."
            log_info "Generated crontab line:"
            echo "  $cron_line"
            ;;

        uninstall)
            local current_cron
            current_cron=$(crontab -l 2>/dev/null || true)

            if ! echo "$current_cron" | grep -q "$cron_comment"; then
                log_warn "No scmn cron job found in crontab."
                return 0
            fi

            echo "$current_cron" | grep -v "$cron_comment" | crontab -
            log_success "Cron job uninstalled."
            ;;

        status)
            local current_cron
            current_cron=$(crontab -l 2>/dev/null || true)

            if echo "$current_cron" | grep -q "$cron_comment"; then
                log_success "Cron job is ACTIVE."
                echo "$current_cron" | grep "$cron_comment"
            else
                log_warn "Cron job is NOT installed."
            fi
            ;;

        *)
            log_error "Unknown cron subcommand. Use: install, uninstall, or status."
            exit 1
            ;;
    esac
}

