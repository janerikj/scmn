    echo "    discord_bot|/home/user/bot|node index.js|none|-|false"
    echo
}

# Main command router
main() {
    local custom_config=""

    # Parse options like -c / --config, -h / --help, -V / --version
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--config)
                if [[ -n "${2:-}" ]]; then
                    custom_config="$2"
                    shift 2
                else
                    log_error "Option '$1' requires a file path argument."
                    exit 1
                fi
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -V|--version)
                echo "scmn ${VERSION}"
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ -n "$custom_config" ]]; then
        if [[ ! -f "$custom_config" ]]; then
            log_error "Specified config file '$custom_config' does not exist!"
            exit 1
        fi
        CONFIG_FILE="$custom_config"
        # Insert custom config at top of lookup list
        DEFAULT_CONFIG_LOCATIONS=("$custom_config" "${DEFAULT_CONFIG_LOCATIONS[@]}")
    fi

    local cmd="${1:-start}"

    case "$cmd" in
        start)
            shift || true
            cmd_start "${1:-}"
            ;;
        status|ls|list)
            cmd_status
            ;;
        reload)
            cmd_reload
            ;;
        check|test|lint)
            cmd_check
            ;;
        enable)
            shift
            cmd_enable "$@"
            ;;
        disable)
            shift
            cmd_disable "$@"
            ;;
        attach|a)
            shift
            cmd_attach "${1:-}" "$cmd"
            ;;
        send)
            shift
            cmd_send "$@"
            ;;
        stop)
            shift
            cmd_stop "${1:-}"
            ;;
        restart)
            shift
            cmd_restart "${1:-}"
            ;;
        log-clear|clear-log)
            shift
            cmd_log_clear "${1:-}"
            ;;
        log|logs)
            shift
            cmd_log "$@"
            ;;
        cron)
            shift
            cmd_cron "${1:-status}"
            ;;
        version|-V|--version)
            echo "scmn ${VERSION}"
            ;;
        --help|-h|help)
            show_help
            ;;
        *)
            log_error "Unknown command: $cmd"
            echo
            show_help
            exit 1
            ;;
    esac
}

main "$@"
