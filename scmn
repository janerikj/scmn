#!/usr/bin/env bash
#
# scmn - Simple Screen Service Manager
# -----------------------------------------------------------------------------
# Manages background services using GNU Screen sessions.
# Supports automatic restarts, process attachment, logging, input sending, and cron monitoring.
#

set -euo pipefail

# Application version
VERSION="v0.11.1"

# Ensure SCREENDIR is set and safe (prevents permission issues on some Linux setups)
if [[ -z "${SCREENDIR:-}" ]]; then
    export SCREENDIR="$HOME/.screen"
fi
if [[ ! -d "$SCREENDIR" ]]; then
    mkdir -p "$SCREENDIR"
    chmod 700 "$SCREENDIR"
fi

# State directory for tracking service configuration signatures (used by reload)
get_state_dir() {
    local statedir="${SCMN_STATE_DIR:-$HOME/.config/scmn/.state}"
    if ! mkdir -p "$statedir" 2>/dev/null; then
        statedir="/tmp/scmn_state_${UID:-0}"
        mkdir -p "$statedir" 2>/dev/null || true
    fi
    echo "$statedir"
}

# Configuration locations (checked in order)
DEFAULT_CONFIG_LOCATIONS=(
    "${SCMN_CONF:-}"
    "./scmn.conf"
    "$HOME/.config/scmn/scmn.conf"
    "/etc/scmn/scmn.conf"
)

CONFIG_FILE=""

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Helper output functions
log_info()    { echo -e "${CYAN}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

# Central event log file (only logs actual actions & state changes, not routine checks)
SCMN_LOG="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"

log_event() {
    local level="$1"
    local msg="$2"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    local logdir
    logdir=$(dirname "$SCMN_LOG")
    if [[ ! -d "$logdir" ]]; then
        mkdir -p "$logdir" 2>/dev/null || true
    fi

    echo "[$timestamp] [$level] $msg" >> "$SCMN_LOG" 2>/dev/null || true
}

find_config() {
    for loc in "${DEFAULT_CONFIG_LOCATIONS[@]}"; do
        if [[ -n "$loc" && -f "$loc" ]]; then
            CONFIG_FILE="$loc"
            return 0
        fi
    done
    return 1
}

ensure_config() {
    if ! find_config; then
        log_error "No configuration file found!"
        log_info "Searched locations:"
        for loc in "./scmn.conf" "$HOME/.config/scmn/scmn.conf" "/etc/scmn/scmn.conf"; do
            echo "  - $loc"
        done
        echo
        log_info "Create a file with format:"
        echo "  # Format: shortname|directory|command|logfile|env|auto_restart"
        echo "  webserver|/var/www/app|python3 -m http.server \$PORT|/var/log/web.log|PORT=8080|true"
        echo "  bot|/home/user/bot|node index.js|none|-|false"
        exit 1
    fi
}

# Screen session snapshot: parse `screen -ls` once per command so
# is_running/get_session_pid become in-memory lookups (each `screen -ls` call
# spawns a screen client process, and status called it 2-3 times per service).
# The snapshot is lazily loaded on first use and refreshed after every screen
# mutation.
declare -A SCREEN_SNAPSHOT=()
SCREEN_SNAPSHOT_LOADED=0

screen_snapshot_parse() {
    local line pid name
    while IFS= read -r line || [[ -n "$line" ]]; do
        # screen -ls line: "<pid>.<session_name>\t(Detached)"
        line="${line#"${line%%[![:space:]]*}"}"
        if [[ "$line" =~ ^[0-9]+\. ]]; then
            pid="${line%%.*}"
            name="${line#*.}"
            SCREEN_SNAPSHOT["${name%%[[:space:]]*}"]="$pid"
        fi
    done
}

screen_snapshot_load() {
    SCREEN_SNAPSHOT=()
    screen_snapshot_parse < <(screen -ls 2>/dev/null || true)
    SCREEN_SNAPSHOT_LOADED=1
}

screen_snapshot_refresh() {
    SCREEN_SNAPSHOT_LOADED=0
    screen_snapshot_load
}

# Checks if screen session with exact shortname is running
is_running() {
    local name="$1"
    if [[ $SCREEN_SNAPSHOT_LOADED -eq 0 ]]; then
        screen_snapshot_load
    fi
    [[ -n "${SCREEN_SNAPSHOT[$name]:-}" ]]
}

# Helper: Get PID of a screen session by shortname
get_session_pid() {
    local name="$1"
    if [[ $SCREEN_SNAPSHOT_LOADED -eq 0 ]]; then
        screen_snapshot_load
    fi
    printf '%s\n' "${SCREEN_SNAPSHOT[$name]:-}"
}

# Deepest live descendant pid under $1: the actual workload process below a
# screen -> bash -c (restart loop) chain. Bounded descent; falls back to $1.
get_leaf_pid() {
    local pid="$1"
    local child
    local depth=0
    while (( depth < 10 )); do
        child=$(pgrep -P "$pid" 2>/dev/null | head -n 1 || true)
        [[ -n "$child" ]] || break
        pid="$child"
        depth=$((depth + 1))
    done
    printf '%s\n' "$pid"
}

# -----------------------------------------------------------------------------
# Docker integration helpers.
#
# `docker run` executes the actual container under dockerd, NOT as a child of
# the `docker run` client process. Killing the screen session (and the docker
# client) therefore leaves the container running. scmn detects docker services
# and gives each one a deterministic container name so it can be stopped and
# removed together with the screen session.
# -----------------------------------------------------------------------------

# Detect whether a service command launches a Docker container
cmd_is_docker() {
    local cmd="$1"
    grep -qE 'docker( container)?[[:space:]]+run' <<<"$cmd"
}

# Checks if a docker command already defines a container name via --name
docker_cmd_has_name() {
    local cmd="$1"
    grep -qE -- '--name(=|$|[[:space:]])' <<<"$cmd"
}

# Deterministic container name derived from the service shortname
docker_service_name() {
    echo "scmn_$(echo "$1" | tr '[:upper:]' '[:lower:]')"
}

# Docker tracking label used to find a service's containers regardless of --name
docker_label_value() {
    echo "scmn.service=$1"
}

# Inject scmn's tracking label (and a deterministic --name when none is given)
# into a docker run command. Label-based tracking works even for containers
# that end up with random names (e.g. leftover containers from scmn v0.8).
docker_inject_start_flags() {
    local cmd="$1"
    local shortname="$2"
    local inject=""
    local inject_name inject_label
    inject_name=$(docker_service_name "$shortname")
    inject_label=$(docker_label_value "$shortname")

    if ! docker_cmd_has_name "$cmd"; then
        inject+=" --name ${inject_name}"
    fi
    if ! grep -q 'scmn\.service=' <<<"$cmd"; then
        inject+=" --label ${inject_label}"
    fi
    if [[ -n "$inject" ]]; then
        echo "$cmd" | sed -E "s/docker( container)?[[:space:]]+run/docker\1 run${inject}/"
    else
        echo "$cmd"
    fi
}

# Extract all container names explicitly set via --name in the command
docker_names_from_cmd() {
    local cmd="$1"
    local match val
    while IFS= read -r match; do
        [[ -z "$match" ]] && continue
        if [[ "$match" == --name=* ]]; then
            val="${match#--name=}"
        else
            val="${match#--name }"
        fi
        val=$(echo "$val" | xargs)
        [[ -n "$val" ]] && echo "$val"
    done < <(grep -oE -- '--name=([^[:space:]|]+)|--name[[:space:]]+[^[:space:]|]+' <<<"$cmd")
}

# All candidate container names for a service: explicit ones + deterministic default
docker_cmd_names() {
    local cmd="$1"
    local shortname="$2"
    docker_names_from_cmd "$cmd"
    docker_service_name "$shortname"
}

# -----------------------------------------------------------------------------
# Docker query cache: `docker ps` / `docker ps -a` are fetched at most once per
# command (status/orphans query them repeatedly). Any docker mutation (run,
# stop, rm) invalidates the cache via docker_query_invalidate().
# Cache keys are container IDs; values:
#   RUNNING: "name<TAB>label"          ALL: "name<TAB>status<TAB>label"
# -----------------------------------------------------------------------------
declare -A DOCKER_CACHE_RUNNING=()
declare -A DOCKER_CACHE_ALL=()
DOCKER_CACHE_LOADED=0

docker_query_load() {
    [[ $DOCKER_CACHE_LOADED -eq 1 ]] && return 0
    DOCKER_CACHE_RUNNING=()
    DOCKER_CACHE_ALL=()

    local line name cid label status
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        name=$(cut -d$'\t' -f1 <<<"$line")
        cid=$(cut -d$'\t' -f2 <<<"$line")
        label=$(cut -d$'\t' -f3 <<<"$line")
        DOCKER_CACHE_RUNNING["$cid"]="$name"$'\t'"$label"
    done < <(docker ps --format '{{.Names}}\t{{.ID}}\t{{.Label "scmn.service"}}' 2>/dev/null || true)

    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        name=$(cut -d$'\t' -f1 <<<"$line")
        cid=$(cut -d$'\t' -f2 <<<"$line")
        status=$(cut -d$'\t' -f3 <<<"$line")
        label=$(cut -d$'\t' -f4 <<<"$line")
        DOCKER_CACHE_ALL["$cid"]="$name"$'\t'"$status"$'\t'"$label"
    done < <(docker ps -a --format '{{.Names}}\t{{.ID}}\t{{.Status}}\t{{.Label "scmn.service"}}' 2>/dev/null || true)

    DOCKER_CACHE_LOADED=1
}

docker_query_invalidate() {
    DOCKER_CACHE_LOADED=0
}

# Exact token match: does space-separated list "$1" contain token "$2"?
docker_names_contain() {
    case " $1 " in
        *" $2 "*) return 0 ;;
        *) return 1 ;;
    esac
}

# Emit "name<TAB>id" lines for containers belonging to a service: matched by
# the scmn.service label OR by any container name this service could use
# (explicit --name in the command, or the deterministic scmn_<shortname>).
# mode: "running" (default) or "all".
docker_matched() {
    local cmd="$1"
    local shortname="$2"
    local mode="${3:-running}"

    # Candidate names come one per line from docker_cmd_names; join to
    # space-separated tokens (names never contain spaces) for exact matching.
    local names=""
    local nm
    while IFS= read -r nm; do
        [[ -n "$nm" ]] && names+=" $nm"
    done < <(docker_cmd_names "$cmd" "$shortname")

    docker_query_load
    local cid entry name label
    if [[ "$mode" == "all" ]]; then
        for cid in "${!DOCKER_CACHE_ALL[@]}"; do
            entry="${DOCKER_CACHE_ALL[$cid]}"
            name="${entry%%$'\t'*}"
            label="${entry#*$'\t'}"
            label="${label#*$'\t'}"
            if [[ "$label" == "$shortname" ]] || docker_names_contain "$names" "$name"; then
                printf '%s\t%s\n' "$name" "$cid"
            fi
        done
    else
        for cid in "${!DOCKER_CACHE_RUNNING[@]}"; do
            entry="${DOCKER_CACHE_RUNNING[$cid]}"
            name="${entry%%$'\t'*}"
            label="${entry#*$'\t'}"
            if [[ "$label" == "$shortname" ]] || docker_names_contain "$names" "$name"; then
                printf '%s\t%s\n' "$name" "$cid"
            fi
        done
    fi
}

# Container IDs (running, or all) belonging to a service
docker_matched_ids() {
    local cmd="$1"
    local shortname="$2"
    local mode="${3:-running}"
    docker_matched "$cmd" "$shortname" "$mode" | cut -f2
}

# True if any candidate container for the service is currently running
docker_any_container_running() {
    local cmd="$1"
    local shortname="$2"
    if ! command -v docker >/dev/null 2>&1; then
        return 1
    fi
    if [[ -n "$(docker_matched_ids "$cmd" "$shortname" running | head -n 1)" ]]; then
        return 0
    fi
    return 1
}

# Uptime (seconds) of a container since it started
docker_container_uptime() {
    local id="$1"
    local started
    started=$(docker inspect -f '{{.State.StartedAt}}' "$id" 2>/dev/null || true)
    [[ -z "$started" ]] && { echo "-"; return 0; }
    local start_epoch now
    start_epoch=$(date -d "$started" +%s 2>/dev/null || true)
    [[ -z "$start_epoch" ]] && { echo "-"; return 0; }
    now=$(date +%s)
    echo $((now - start_epoch))
}

# Resident memory of a container (best effort): cgroup memory.current when
# available (whole container incl. children), else the container's main
# process RSS from /proc, else docker stats MemUsage. Emits e.g. "26MB".
# With arg "strict", only report the whole-container cgroup value; otherwise
# report "-" (the /proc docker stats approximations are not container RAM).
docker_container_ram() {
    local id="$1" strict="${2:-}"
    local mem

    # cgroup v2 memory controller (delegated to the container scope).
    local full_id cgrp
    full_id=$(docker inspect -f '{{.Id}}' "$id" 2>/dev/null || true)
    if [[ -n "$full_id" ]]; then
        cgrp="/sys/fs/cgroup/system.slice/docker-${full_id}.scope/memory.current"
        if [[ -r "$cgrp" ]]; then
            mem=$(cat "$cgrp" 2>/dev/null || true)
            if [[ -n "$mem" && "$mem" -gt 0 ]] 2>/dev/null; then
                awk -v bytes="$mem" 'BEGIN{ printf "%dMB\n", bytes/1048576 }'
                return 0
            fi
        fi
    fi

    # Strict tool: only the true whole-container value (memory.current) counts;
    # the RSS sums / docker stats below are not container RAM.
    [[ "$strict" == "strict" ]] && { printf -- '-\n'; return 0; }

    # Lenient fallbacks for callers that accept an approximation:
    # No memory controller: sum RSS over all container processes
    # (cgroup.procs), which is more truthful than the main PID alone.
    if [[ -n "$full_id" ]]; then
        local scope="/sys/fs/cgroup/system.slice/docker-${full_id}.scope"
        if [[ -r "$scope/cgroup.procs" ]]; then
            local total=0 p rss
            while IFS= read -r p; do
                [[ -n "$p" ]] || continue
                rss=$(awk '{ print $2 }' "/proc/$p/statm" 2>/dev/null || true)
                [[ -n "$rss" ]] && total=$((total + rss))
            done < "$scope/cgroup.procs"
            if [[ "$total" -gt 0 ]]; then
                awk -v pages="$total" 'BEGIN{ printf "%dMB\n", (pages*4096)/1048576 }'
                return 0
            fi
        fi
    fi

    # Fallback: RSS of the container's main process (PID 1) via /proc.
    local pid
    pid=$(docker inspect -f '{{.State.Pid}}' "$id" 2>/dev/null || true)
    if [[ -n "$pid" && "$pid" != "0" ]] && [[ -r "/proc/$pid/statm" ]]; then
        local rss_pages
        rss_pages=$(awk '{ print $2 }' "/proc/$pid/statm" 2>/dev/null || true)
        if [[ -n "$rss_pages" ]]; then
            awk -v pages="$rss_pages" 'BEGIN{ printf "%dMB\n", (pages*4096)/1048576 }'
            return 0
        fi
    fi

    # Last resort: docker stats (MemUsage, first field).
    mem=$(docker stats --no-stream --format '{{.MemUsage}}' "$id" 2>/dev/null || true)
    if [[ -n "$mem" ]]; then
        printf '%s\n' "$mem" | awk '{print $1}'
    else
        printf '-\n'
    fi
}

# Stop (and remove) all containers belonging to a docker service
docker_stop_cmd() {
    local cmd="$1"
    local shortname="$2"
    if ! command -v docker >/dev/null 2>&1; then
        log_warn "Docker not available; cannot stop containers for service '$shortname'."
        return 0
    fi

    local -a ids=()
    local id
    while IFS= read -r id; do
        [[ -n "$id" ]] && ids+=("$id")
    done < <(docker_matched_ids "$cmd" "$shortname" all)

    if [[ ${#ids[@]} -eq 0 ]]; then
        return 0
    fi

    local stopped_any=false
    docker_query_load
    for id in "${ids[@]:-}"; do
        if [[ -n "$id" ]] && [[ -n "${DOCKER_CACHE_RUNNING[$id]:-}" ]]; then
            docker stop "$id" >/dev/null 2>&1 || true
            log_info "Stopping Docker container '$id' for service '$shortname'."
            stopped_any=true
        fi
    done

    if $stopped_any; then
        sleep 1
    fi

    # Remove the container so a later start does not collide with the name
    for id in "${ids[@]:-}"; do
        if [[ -n "$id" ]]; then
            docker rm -f "$id" >/dev/null 2>&1 || true
            log_info "Removed Docker container '$id' for service '$shortname'."
        fi
    done
    docker_query_invalidate
}

# Look up the configured command for a service shortname (empty if not found)
get_service_cmd() {
    local target="$1"
    if [[ $SERVICES_LOADED -eq 0 ]]; then
        load_services
    fi
    printf '%s\n' "${SVC_CMD[$target]:-}"
}

# Helper: Check service runtime state ("RUNNING", "RESTARTING", or "STOPPED")
get_service_state() {
    local name="$1"
    local cmd="${2:-}"

    if ! is_running "$name"; then
        if cmd_is_docker "$cmd" && docker_any_container_running "$cmd" "$name"; then
            echo "ORPHANED"
            return 0
        fi
        echo "STOPPED"
        return 0
    fi

    local screen_pid
    screen_pid=$(get_session_pid "$name")
    if [[ -z "$screen_pid" ]]; then
        echo "STOPPED"
        return 0
    fi

    local wrapper_pid
    wrapper_pid=$(pgrep -P "$screen_pid" 2>/dev/null | head -n 1 || true)

    if [[ -n "$wrapper_pid" ]]; then
        # Docker services are never wrapped in a scmn restart loop anymore, so a
        # sleeping child is internal to the docker client (e.g. attach idle),
        # never a restart cooldown. Report straight RUNNING.
        if cmd_is_docker "$cmd"; then
            echo "RUNNING"
            return 0
        fi

        local child_pids
        child_pids=$(pgrep -P "$wrapper_pid" 2>/dev/null || true)

        if [[ -n "$child_pids" ]]; then
            local child_comms
            child_comms=$(ps -o comm= -p $child_pids 2>/dev/null | xargs || true)

            # If child process is 'sleep' and command is not a sleep command, service is in restart cooldown
            if [[ "$child_comms" == *"sleep"* ]] && [[ "$cmd" != sleep* ]]; then
                echo "RESTARTING"
                return 0
            fi
        fi
    fi

    echo "RUNNING"
}

# Start a specific service from config definition
start_service() {
    local name="$1"
    local dir="$2"
    local cmd="$3"
    local logfile="${4:-none}"
    local env_vars="${5:-none}"
    local auto_restart="${6:-false}"

    if is_running "$name"; then
        log_info "Service '$name' is already running."
        return 0
    fi

    # Trim fields
    name="$(trim "$name")"
    dir="$(trim "$dir")"
    cmd="$(trim "$cmd")"
    logfile="$(trim "$logfile")"
    env_vars="$(trim "$env_vars")"
    auto_restart="$(trim "$auto_restart")"

    # Raw command as configured; the state file signature must match what reload
    # reads from the config (the injected docker flags are runtime-only).
    local raw_cmd="$cmd"

    # Validate directory
    if [[ -n "$dir" && "$dir" != "-" ]]; then
        if [[ ! -d "$dir" ]]; then
            log_error "Directory '$dir' for service '$name' does not exist!"
            return 1
        fi
    fi

    # A detached docker container may outlive its screen session (docker run -d
    # returns immediately). Treat an already-running container as "running" so
    # cron/start/reload never tears a healthy container down to restart it.
    if cmd_is_docker "$cmd" && docker_any_container_running "$cmd" "$name"; then
        log_info "Service '$name' is already running as a Docker container."
        return 0
    fi

    # Docker integration: ensure a deterministic container name AND a tracking
    # label so containers are findable for stopping, and remove stale ones
    # before starting.
    if cmd_is_docker "$cmd"; then
        cmd=$(docker_inject_start_flags "$cmd" "$name")
        log_info "Service '$name' uses docker run; ensured --label $(docker_label_value "$name") [$(docker_service_name "$name")]"
        local old_id
        while IFS= read -r old_id; do
            [[ -n "$old_id" ]] || continue
            log_warn "Removing leftover Docker container '$old_id' for service '$name' before start."
            docker rm -f "$old_id" >/dev/null 2>&1 || true
        done < <(docker_matched_ids "$cmd" "$name" all)
        docker_query_invalidate
    fi

    # Build screen command (-U for UTF-8 mode, -h for scrollback buffer)
    local scrollback="${SCMN_SCROLLBACK:-1000}"
    local screen_args=(-U -h "$scrollback" -dmS "$name")

    # Logging options
    if [[ -n "$logfile" && "$logfile" != "none" && "$logfile" != "off" && "$logfile" != "-" ]]; then
        local logdir
        logdir=$(dirname "$logfile")
        if [[ ! -d "$logdir" ]]; then
            mkdir -p "$logdir" 2>/dev/null || true
        fi
        screen_args+=(-L -Logfile "$logfile")
    fi

    # Prepare execution wrapper with env vars and auto-restart loop if enabled
    local exec_cmd=""

    if [[ -n "$env_vars" && "$env_vars" != "none" && "$env_vars" != "-" ]]; then
        exec_cmd="export $env_vars; "
    fi

    local restart_mode
    restart_mode="$(normalize_restart "$auto_restart")"
    restart_mode="$(trim "$restart_mode")"
    [[ -n "$restart_mode" ]] || restart_mode="never"

    # Docker services are NEVER wrapped in a restart loop: `docker run` collides
    # with the still-running container (--name taken) and would fail forever,
    # spawning docker client processes instead of supervising. Docker containers
    # are restarted by the engine's own --restart policy instead.
    if cmd_is_docker "$cmd"; then
        exec_cmd="${exec_cmd}$cmd"
    elif [[ "$restart_mode" == "always" ]]; then
        exec_cmd="${exec_cmd}while true; do $cmd; echo '[scmn] Process exited. Restarting in 2s...'; sleep 2; done"
    elif [[ "$restart_mode" == "on-failure" ]]; then
        exec_cmd="${exec_cmd}while true; do $cmd; _code=\$?; if [ \$_code -eq 0 ]; then echo '[scmn] Process exited cleanly (exit code 0). Stopping.'; break; fi; echo \"[scmn] Process failed (exit code \$_code). Restarting in 2s...\"; sleep 2; done"
    else
        exec_cmd="${exec_cmd}$cmd"
    fi

    # Launch in specified directory if present
    if [[ -n "$dir" && "$dir" != "-" ]]; then
        (
            cd "$dir"
            screen "${screen_args[@]}" bash -c "$exec_cmd"
        )
    else
        screen "${screen_args[@]}" bash -c "$exec_cmd"
    fi

    # Configure visual status/caption bar inside Screen when attached
    screen -S "$name" -X caption always "%{= kc}[scmn: $name]%{= kw} | Detach: %{= ky}Ctrl+A D%{= kw} | Host: %H | %c" 2>/dev/null || true

    sleep 0.4
    screen_snapshot_refresh
    docker_query_invalidate
    local initial_state
    initial_state=$(get_service_state "$name" "$cmd")

    if [[ "$initial_state" == "RUNNING" ]]; then
        state_write "$name" "$dir" "$raw_cmd" "$logfile" "$env_vars" "$auto_restart"
        log_success "Started service '$name' (Command: $cmd)"
        log_event "OK" "Started service '$name' (Command: $cmd)"
    elif [[ "$initial_state" == "RESTARTING" ]]; then
        state_write "$name" "$dir" "$raw_cmd" "$logfile" "$env_vars" "$auto_restart"
        log_warn "Started session for '$name', but command failed/is restarting (Command: $cmd)"
        log_event "WARN" "Started session for '$name', but command failed/is restarting (Command: $cmd)"
    elif is_running "$name"; then
        state_write "$name" "$dir" "$raw_cmd" "$logfile" "$env_vars" "$auto_restart"
        log_success "Started service '$name' (Command: $cmd)"
        log_event "OK" "Started service '$name' (Command: $cmd)"
    elif [[ "$initial_state" == "ORPHANED" ]]; then
        # Docker run -d returns immediately: the container is the service and
        # runs under dockerd even though the screen session has already ended.
        state_write "$name" "$dir" "$raw_cmd" "$logfile" "$env_vars" "$auto_restart"
        log_success "Started service '$name' as detached Docker container (Command: $cmd)"
        log_event "OK" "Started service '$name' as detached Docker container (Command: $cmd)"
    else
        log_error "Failed to start service '$name'."
        log_event "ERROR" "Failed to start service '$name'."
        return 1
    fi
}

# Max log size in MB before truncation (default: 50MB)
MAX_LOG_SIZE_MB="${MAX_LOG_SIZE_MB:-50}"

# Truncates a logfile in-place if it exceeds MAX_LOG_SIZE_MB
truncate_log_if_needed() {
    local name="$1"
    local logfile="$2"

    if [[ -z "$logfile" || "$logfile" == "none" || "$logfile" == "off" || "$logfile" == "-" ]]; then
        return 0
    fi

    if [[ ! -f "$logfile" ]]; then
        return 0
    fi

    local max_bytes=$((MAX_LOG_SIZE_MB * 1024 * 1024))
    local current_size
    current_size=$(stat -c%s "$logfile" 2>/dev/null || echo 0)

    if (( current_size > max_bytes )); then
        local size_mb=$((current_size / 1024 / 1024))
        log_warn "Log file for '$name' ($logfile) exceeds limit: ${size_mb}MB / ${MAX_LOG_SIZE_MB}MB. Truncating..."

        local temp_tail
        temp_tail=$(mktemp)

        # Retain last 25MB (half of max limit) so log grows from 25MB up to 50MB again
        local keep_bytes=$((max_bytes / 2))
        tail -c "$keep_bytes" "$logfile" > "$temp_tail" 2>/dev/null || true
        cat "$temp_tail" > "$logfile" 2>/dev/null || true
        rm -f "$temp_tail"

        log_success "Truncated '$logfile' to last $((keep_bytes / 1024 / 1024))MB."
        log_event "WARN" "Truncated log file '$logfile' for service '$name' (${size_mb}MB -> $((keep_bytes / 1024 / 1024))MB)."
    fi
}

# -----------------------------------------------------------------------------
# Configuration: parsed ONCE per command into in-memory maps. parse_config()
# iterates the cached data (no-op after the first load), so commands that
# inspect the config more than once (status, start --all, reload) no longer
# re-read the file and re-spawn sed/xargs per line. Call invalidate_services()
# whenever the config file is replaced.
# -----------------------------------------------------------------------------
declare -a SERVICES=()
declare -A SVC_DIR=() SVC_CMD=() SVC_LOG=() SVC_ENV=() SVC_RESTART=() SVC_DISABLED=() SVC_LINE=()
SERVICES_LOADED=0

# Trim leading/trailing whitespace (pure bash; no sed/xargs subprocesses)
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Lowercase a string (subprocess only when argument is non-empty)
lower() {
    [[ -n "$1" ]] && printf '%s' "${1,,}" || printf '%s' "$1"
}

# Canonical auto_restart policy: "always" | "on-failure" | "never".
# Empty string on unknown/unsupported input (so callers can warn).
normalize_restart() {
    case "$(lower "${1:-}")" in
        always|true|1|yes) printf 'always' ;;
        on-failure|on_failure|failure|fail) printf 'on-failure' ;;
        never|false|no|0|-) printf 'never' ;;
        *) return 1 ;;
    esac
}

# Write the runtime state file for a service (dir|cmd|logfile|env|auto_restart)
state_write() {
    local name="$1" dir="$2" cmd="$3" logfile="$4" env_vars="$5" auto_restart="$6"
    printf '%s|%s|%s|%s|%s\n' "$dir" "$cmd" "$logfile" "$env_vars" "$auto_restart" \
        > "$(get_state_dir)/$name.state" 2>/dev/null || true
}

# Remove the runtime state file for a service
state_remove() {
    rm -f "$(get_state_dir)/$1.state" 2>/dev/null || true
}

# RAM (MB) and uptime (formatted) for a non-docker pid: emits "ram<TAB>uptime"
proc_metrics() {
    local pid="$1"
    local rss uptime_str
    rss=$(ps -p "$pid" -o rss= 2>/dev/null | xargs || echo 0)
    if [[ -n "$rss" && "$rss" -gt 0 ]]; then
        printf '%dMB\t' "$((rss / 1024))"
    else
        printf -- '-\t'
    fi
    uptime_str=$(ps -p "$pid" -o etime= 2>/dev/null | xargs || echo "-")
    if [[ -n "$uptime_str" && "$uptime_str" != "-" ]]; then
        format_uptime "$uptime_str"
    else
        printf -- '-'
    fi
}

# RAM (MB) and uptime (formatted) for a docker container id: emits "ram<TAB>uptime"
docker_metrics() {
    local cid="$1"
    local mem
    mem=$(docker_container_ram "$cid")
    if [[ -n "$mem" && "$mem" != "-" ]]; then
        printf '%s\t' "$(printf '%s' "$mem" | tr -d ' ')"
    else
        printf -- '-\t'
    fi
    local cup
    cup=$(docker_container_uptime "$cid")
    if [[ -n "$cup" && "$cup" != "-" ]]; then
        format_uptime "$(secs_to_etime "$cup")"
    else
        printf -- '-'
    fi
}

load_services() {
    ensure_config
    SERVICES=()
    SVC_DIR=() SVC_CMD=() SVC_LOG=() SVC_ENV=() SVC_RESTART=() SVC_DISABLED=() SVC_LINE=()

    local line_num=0
    local trimmed_line parse_line name dir cmd logfile env_vars auto_restart is_comment is_disabled
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_num=$((line_num + 1))

        # Strip leading/trailing whitespace
        trimmed_line="$(trim "$line")"

        # Ignore empty lines
        [[ -n "$trimmed_line" ]] || continue

        is_comment=false
        if [[ "$trimmed_line" == \#* ]]; then
            is_comment=true
        fi

        parse_line="$trimmed_line"
        is_disabled=false
        if $is_comment; then
            # Strip leading # and whitespace
            parse_line="$(trim "${trimmed_line#\#}")"
            is_disabled=true
        fi

        # Check if line contains pipe delimiter
        [[ "$parse_line" == *"|"* ]] || continue

        # Parse pipe-separated values: shortname|directory|command|logfile|env|auto_restart
        name="" dir="" cmd="" logfile="" env_vars="" auto_restart=""
        IFS='|' read -r name dir cmd logfile env_vars auto_restart <<< "$parse_line"

        name="$(trim "${name:-}")"
        dir="$(trim "${dir:-}")"
        cmd="$(trim "${cmd:-}")"
        logfile="$(trim "${logfile:-}")"
        env_vars="$(trim "${env_vars:-}")"
        auto_restart="$(trim "${auto_restart:-}")"

        # Validate name and command
        if [[ -z "$name" || -z "$cmd" ]]; then
            if [[ $is_comment == "false" ]]; then
                log_warn "Line $line_num in '$CONFIG_FILE' missing shortname or command: $line"
            fi
            continue
        fi

        # Filter out header comments that might contain pipes
        if [[ "$name" =~ ^(shortname|Format|Format:|Rules:|Rules)$ ]] || [[ ! "$name" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
            continue
        fi

        SERVICES+=("$name")
        SVC_DIR["$name"]="$dir"
        SVC_CMD["$name"]="$cmd"
        SVC_LOG["$name"]="$logfile"
        SVC_ENV["$name"]="$env_vars"
        SVC_RESTART["$name"]="$auto_restart"
        SVC_DISABLED["$name"]="$is_disabled"
        SVC_LINE["$name"]=$line_num
    done < "$CONFIG_FILE"

    SERVICES_LOADED=1
}

# Parse config file and execute callback function for each valid service.
# Callback format: fn "name" "dir" "cmd" "logfile" "env" "auto_restart" [is_disabled]
parse_config() {
    local callback="$1"
    local include_disabled="${2:-false}"

    if [[ $SERVICES_LOADED -eq 0 ]]; then
        load_services
    fi

    local name
    for name in "${SERVICES[@]:-}"; do
        if [[ "${SVC_DISABLED[$name]}" == "true" && "$include_disabled" != "true" ]]; then
            continue
        fi
        "$callback" "$name" "${SVC_DIR[$name]}" "${SVC_CMD[$name]}" "${SVC_LOG[$name]}" "${SVC_ENV[$name]}" "${SVC_RESTART[$name]}" "${SVC_DISABLED[$name]}" || true
    done
}

# Mark the cached service maps stale (call after the config file is rewritten)
invalidate_services() {
    SERVICES_LOADED=0
}

## Command: Start missing services (all or single target) + truncate logs
cmd_start() {
    local target="${1:-}"
    #find_config
    ensure_config
    log_info "Using configuration: ${CONFIG_FILE}"

    if [[ -n "$target" && "$target" != "--all" ]]; then
        log_info "Checking and starting target service '$target'..."
        echo
        local found=false

        start_single_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"
            local env_vars="$5"
            local auto_restart="$6"
            local is_disabled="${7:-false}"

            if [[ "$name" == "$target" ]]; then
                found=true
                if [[ "$is_disabled" == "true" ]]; then
                    log_warn "Service '$target' is disabled in configuration. Use 'scmn enable $target --now' to enable and start it."
                    return 0
                fi
                start_service "$name" "$dir" "$cmd" "$logfile" "$env_vars" "$auto_restart"
                truncate_log_if_needed "$name" "$logfile"
            fi
        }

        parse_config start_single_callback "true"

        if ! $found; then
            log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
            exit 1
        fi
    else
        log_info "Checking and starting missing services..."
        echo

        parse_config start_service

        echo
        log_info "Checking log file sizes (Limit: ${MAX_LOG_SIZE_MB}MB)..."

        check_logs_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"

            truncate_log_if_needed "$name" "$logfile"
        }

        parse_config check_logs_callback
    fi
}


format_uptime() {
    local etime="$1"
    local days=0 h=0 m=0 s=0

    case "$etime" in
        *-*)
            days=${etime%%-*}
            IFS=: read -r h m s <<< "${etime#*-}"
            ;;
        *:*:*)
            IFS=: read -r h m s <<< "$etime"
            ;;
        *:*)
            IFS=: read -r m s <<< "$etime"
            ;;
    esac

    #local total=$((days*86400 + h*3600 + m*60 + s))
    local total=$((10#$days*86400 + 10#$h*3600 + 10#$m*60 + 10#$s))

    if (( total < 48*3600 )); then
        printf "%02d:%02d:%02d\n" $((total/3600)) $(((total%3600)/60)) $((total%60))

    elif (( total < 365*86400 )); then
        printf "%dd %dh\n" $((total/86400)) $(((total%86400)/3600))

    else
        printf "%dy %dd\n" $((total/31536000)) $(((total%31536000)/86400))
    fi
}

# Convert seconds to an etime-style string for format_uptime
secs_to_etime() {
    local s="${1:-0}" d h m
    s=$((10#$s))
    d=$((s / 86400)); s=$((s % 86400))
    h=$((s / 3600));  s=$((s % 3600))
    m=$((s / 60));    s=$((s % 60))
    if (( d > 0 )); then
        printf "%d-%02d:%02d:%02d\n" "$d" "$h" "$m" "$s"
    else
        printf "%02d:%02d:%02d\n" "$h" "$m" "$s"
    fi
}

# Command: List status of all configured services with metrics
cmd_status() {
    ensure_config
    log_info "Configuration file: ${CONFIG_FILE}"
    echo
    printf "${BOLD}%-14s %-10s %-12s %-6s %-10s %-10s %-27s %s${NC}\n" \
        "SHORTNAME" "STATUS" "PID" "RAM" "UPTIME" "RESTART" "COMMAND" "LOGFILE"
    printf "%s\n" "--------------------------------------------------------------------------------------------------------------------------------"

    status_callback() {
        local name="$1"
        local dir="${2:-.}"
        local cmd="$3"
        local logfile="${4:-none}"
        local env_vars="${5:-none}"
        local auto_restart="${6:-false}"
        local is_disabled="${7:-false}"

        local status_colored=""
        local pid_str="-"
        local ram_str="-"
        local uptime_str="-"

        if [[ "$is_disabled" == "true" ]]; then
            if is_running "$name"; then
                # Disabled in config, but session still actively running
                status_colored="${YELLOW}DISABLED*${NC} "
                local main_pid
                main_pid=$(get_session_pid "$name")
                if [[ -n "$main_pid" ]]; then
                    local target_pid ram_str2 uptime_str2
                    target_pid=$(get_leaf_pid "$main_pid")
                    pid_str="$target_pid"
                    IFS=$'\t' read -r ram_str2 uptime_str2 < <(proc_metrics "$target_pid")
                    ram_str="$ram_str2"
                    uptime_str="$uptime_str2"
                fi
            else
                # Visible width: 10 chars ("DISABLED" + 2 spaces)
                status_colored="${GRAY}DISABLED${NC}  "
            fi
        else
            local state
            state=$(get_service_state "$name" "$cmd")

            if [[ "$state" == "RUNNING" ]]; then
                # Visible width: 10 chars ("RUNNING" + 3 spaces)
                status_colored="${GREEN}RUNNING${NC}   "
                local main_pid
                main_pid=$(get_session_pid "$name")
                if cmd_is_docker "$cmd"; then
                    # Docker: report the container itself (docker run client is
                    # just an attach proxy under dockerd, not the workload).
                    local cid
                    cid=$(docker_matched_ids "$cmd" "$name" running | head -n 1)
                    if [[ -n "$cid" ]]; then
                        pid_str="${cid:0:12}"
                        local ram_str2 uptime_str2
                        IFS=$'\t' read -r ram_str2 uptime_str2 < <(docker_metrics "$cid")
                        ram_str="$ram_str2"
                        uptime_str="$uptime_str2"
                    fi
                elif [[ -n "$main_pid" ]]; then
                    local target_pid ram_str2 uptime_str2
                    target_pid=$(get_leaf_pid "$main_pid")
                    pid_str="$target_pid"
                    IFS=$'\t' read -r ram_str2 uptime_str2 < <(proc_metrics "$target_pid")
                    ram_str="$ram_str2"
                    uptime_str="$uptime_str2"
                fi
            elif [[ "$state" == "RESTARTING" ]]; then
                # Visible width: 10 chars ("RESTARTING" + 0 spaces)
                status_colored="${YELLOW}RESTARTING${NC}"
                local main_pid
                main_pid=$(get_session_pid "$name")
                if [[ -n "$main_pid" ]]; then
                    pid_str="$main_pid"
                fi
            elif [[ "$state" == "ORPHANED" ]]; then
                # Visible width: 10 chars ("ORPHANED" + 2 spaces)
                status_colored="${YELLOW}ORPHANED${NC}  "
                local oid
                oid=$(docker_matched_ids "$cmd" "$name" running | head -n 1)
                if [[ -n "$oid" ]]; then
                    pid_str="${oid:0:12}"
                fi
            else
                # Visible width: 10 chars ("STOPPED" + 3 spaces)
                status_colored="${RED}STOPPED${NC}   "
            fi
        fi

        local restart_display="no"
        case "$(normalize_restart "$auto_restart")" in
            on-failure) restart_display="on-failure" ;;
            always) restart_display="always" ;;
        esac

        printf "%-14s %b %-12s %-6s %-10s %-10s %-27s %s\n" \
            "${name:0:13}" \
            "$status_colored" \
            "${pid_str:0:12}" \
            "${ram_str:0:5}" \
            "${uptime_str:0:9}" \
            "${restart_display:0:13}" \
            "${cmd:0:27}" \
            "$logfile"
    }

    parse_config status_callback "true"
    echo

    log_info "Checking log file sizes (Limit: ${MAX_LOG_SIZE_MB}MB)..."

    check_logs_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        truncate_log_if_needed "$name" "$logfile"
    }

    parse_config check_logs_callback

}

# One aligned metrics row for the detail page:
# "LABEL  pid X     RAM Y     up Z     (tag)"
detail_metrics_row() {
    local label="$1" pid="$2" ram="$3" up="$4" tag="${5:-}"
    printf '%-18s pid %-8s RAM %-7s up %-10s (%s)\n' \
        "$label" "${pid:--}" "${ram:--}" "${up:--}" "${tag:--}"
}

# One process row (RAM/uptime from /proc, process name as tag).
detail_proc_row() {
    local label="$1" pid="$2" tag="${3:-}"
    local ram up comm
    if [[ -n "$tag" ]]; then
        comm="$tag"
    else
        comm=$(ps -o comm= -p "$pid" 2>/dev/null | xargs || true)
    fi
    IFS=$'\t' read -r ram up < <(proc_metrics "$pid")
    detail_metrics_row "$label" "$pid" "$ram" "$up" "$comm"
}

# Command: Detailed status page for a single service showing both the screen
# session and the workload process (or docker container) metrics.
cmd_status_detail() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        log_error "Please specify a service shortname."
        log_info "Usage: scmn status <shortname>"
        exit 1
    fi

    ensure_config
    load_services

    if [[ -z "${SVC_LINE[$name]:-}" && -z "${SVC_CMD[$name]:-}" ]]; then
        log_error "Service '$name' not found in configuration file '${CONFIG_FILE}'."
        exit 1
    fi

    local cmd="${SVC_CMD[$name]:-}"
    local dir="${SVC_DIR[$name]:--}"
    local logfile="${SVC_LOG[$name]:-}"
    local auto_restart="${SVC_RESTART[$name]:-false}"
    local disabled="${SVC_DISABLED[$name]:-false}"

    local restart_display="no"
    case "$(normalize_restart "$auto_restart")" in
        on-failure) restart_display="on-failure" ;;
        always) restart_display="always" ;;
    esac

    local state
    state=$(get_service_state "$name" "$cmd")
    local status_label="$state"
    if [[ "$disabled" == "true" ]]; then
        if [[ "$state" == "STOPPED" ]]; then
            status_label="DISABLED"
        else
            status_label="${state} (disabled)"
        fi
    fi

    local is_docker=false
    [[ -n "$cmd" ]] && cmd_is_docker "$cmd" && is_docker=true

    echo
    printf '%-18s %s\n' "Service:" "$name"
    printf '%-18s %s\n' "Status:" "$status_label"
    printf '%-18s %s\n' "Working dir:" "${dir:--}"
    printf '%-18s %s\n' "Command:" "$cmd"
    printf '%-18s %s\n' "Logfile:" "${logfile:-none}"
    printf '%-18s %s\n' "Auto-restart:" "$restart_display"
    echo

    local screen_pid
    screen_pid=$(get_session_pid "$name")

    if $is_docker; then
        local cid
        cid=$(docker_matched_ids "$cmd" "$name" running | head -n 1)
        if [[ -z "$cid" ]]; then
            cid=$(docker_matched_ids "$cmd" "$name" all | head -n 1)
        fi
        if [[ -n "$screen_pid" ]]; then
            detail_proc_row "Screen session:" "$screen_pid"
        else
            printf '%-18s not running\n' "Screen session:"
        fi
        if [[ -n "$cid" ]]; then
            local cpid dram dupt
            cpid=$(docker inspect -f '{{.State.Pid}}' "$cid" 2>/dev/null || true)
            [[ -z "$cpid" || "$cpid" == "0" ]] && cpid="-"
            dram=$(docker_container_ram "$cid" strict)
            dupt=$(docker_container_uptime "$cid")
            if [[ -n "$dupt" && "$dupt" != "-" ]]; then
                dupt=$(format_uptime "$(secs_to_etime "$dupt")")
            fi
            detail_metrics_row "Container:" "$cpid" "$dram" "${dupt:--}" "${cid:0:12}"
            if [[ "$cpid" != "-" ]]; then
                detail_proc_row "Workload proc:" "$cpid"
            else
                printf '%-18s not running\n' "Workload proc:"
            fi
        else
            printf '%-18s not running\n' "Container:"
            printf '%-18s not running\n' "Workload proc:"
        fi
    else
        if [[ -n "$screen_pid" ]]; then
            detail_proc_row "Screen session:" "$screen_pid"
            detail_proc_row "Workload proc:" "$(get_leaf_pid "$screen_pid")"
        else
            printf '%-18s not running\n' "Screen session:"
            printf '%-18s not running\n' "Workload proc:"
        fi
    fi
    echo
}

# Stop a single service with graceful SIGTERM, SIGKILL fallback, and
# Docker container cleanup (docker containers survive screen termination).
stop_service_by_name() {
    local name="$1"
    local cmd="${2:-}"
    local is_docker=false

    if [[ -z "$cmd" ]]; then
        cmd=$(get_service_cmd "$name")
    fi
    if [[ -n "$cmd" ]] && cmd_is_docker "$cmd"; then
        is_docker=true
    fi

    if ! is_running "$name" && ! $is_docker; then
        log_warn "Service '$name' is not running."
        return 0
    fi

    local pid
    pid=$(get_session_pid "$name")

    if [[ -n "$pid" ]]; then
        # Step 1: Send graceful shutdown signal via screen quit (SIGTERM)
        screen -X -S "$name" quit 2>/dev/null || true

        # Step 2: Wait up to 2 seconds (10 steps of 0.2s) for clean termination
        local waited=0
        local max_wait=10
        while is_running "$name" && (( waited < max_wait )); do
            sleep 0.2
            screen_snapshot_refresh
            waited=$((waited + 1))
        done

        # Step 3: Check if still running; if so, force kill (SIGKILL)
        if is_running "$name"; then
            log_warn "Service '$name' did not stop gracefully within 2s. Force killing (SIGKILL)..."
            log_event "WARN" "Service '$name' did not stop gracefully within 2s. Force killing (SIGKILL)."
            # Kill child processes inside screen session first, then screen itself
            pkill -9 -P "$pid" 2>/dev/null || true
            kill -9 "$pid" 2>/dev/null || true
            screen -wipe 2>/dev/null || true
            sleep 0.2
            screen_snapshot_refresh
        fi
    fi

    # Step 4: Stop/remove Docker containers launched by this service. `docker
    # run` executes the container under dockerd, not under the screen session's
    # process tree, so it keeps running even when the screen session is gone.
    if $is_docker; then
        docker_stop_cmd "$cmd" "$name"
    fi

    local screen_stopped=true
    local docker_stopped=true
    if is_running "$name"; then
        screen_stopped=false
    fi
    if $is_docker && docker_any_container_running "$cmd" "$name"; then
        docker_stopped=false
    fi

    if $screen_stopped && $docker_stopped; then
        state_remove "$name"
        log_success "Stopped service '$name'."
        log_event "OK" "Stopped service '$name'."
    else
        log_error "Failed to stop service '$name' (screen running: $screen_stopped, docker running: $docker_stopped)."
        log_event "ERROR" "Failed to stop service '$name' even with SIGKILL."
    fi
}

# Command: Enable a disabled service in config (uncomment) and optionally start immediately (--now)
cmd_enable() {
    cmd_toggle enable "$@"
}

# Command: Disable an enabled service in config (comment out) and optionally stop immediately (--now)
cmd_disable() {
    cmd_toggle disable "$@"
}

# Shared implementation for enable/disable. action: "enable" | "disable"
cmd_toggle() {
    local action="${1:-}"
    local target=""
    local now=false
    [[ "$action" == "enable" ]] && local enable=true || local enable=false
    shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --now)
                now=true
                shift
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$target" ]]; then
        log_error "Please specify the service shortname to $(lower "$action")!"
        log_info "Usage: scmn $action <shortname> [--now]"
        exit 1
    fi

    ensure_config

    if [[ ! -w "$CONFIG_FILE" ]]; then
        log_error "Configuration file '$CONFIG_FILE' is not writable. Check permissions (or run with sudo)."
        exit 1
    fi

    local temp_file
    temp_file=$(mktemp "${CONFIG_FILE}.tmp.XXXXXX" 2>/dev/null || mktemp -t scmn_conf.XXXXXX)

    local found=false
    local already_done=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        local trimmed
        trimmed="$(trim "$line")"

        if $enable; then
            # Enable: uncomment a disabled (#target|) line; leave active lines as-is
            if [[ "$trimmed" =~ ^${target}[[:space:]]*\| ]]; then
                found=true
                already_done=true
                echo "$line" >> "$temp_file"
            elif [[ "$trimmed" =~ ^#[[:space:]]*${target}[[:space:]]*\| ]]; then
                found=true
                # Remove leading '#' and optional space after '#'
                local uncommented
                uncommented="$(echo "$line" | sed -E 's/^([[:space:]]*)#[[:space:]]?/\1/')"
                echo "$uncommented" >> "$temp_file"
            else
                echo "$line" >> "$temp_file"
            fi
        else
            # Disable: comment out an active (target|) line; leave disabled lines as-is
            if [[ "$trimmed" =~ ^#[[:space:]]*${target}[[:space:]]*\| ]]; then
                found=true
                already_done=true
                echo "$line" >> "$temp_file"
            elif [[ "$trimmed" =~ ^${target}[[:space:]]*\| ]]; then
                found=true
                # Prefix with '# ' while preserving leading whitespace
                local commented
                commented="$(echo "$line" | sed -E 's/^([[:space:]]*)/\1# /')"
                echo "$commented" >> "$temp_file"
            else
                echo "$line" >> "$temp_file"
            fi
        fi
    done < "$CONFIG_FILE"

    if ! $found; then
        rm -f "$temp_file"
        log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
        exit 1
    fi

    if $already_done; then
        rm -f "$temp_file"
        log_warn "Service '$target' is already $(lower "$action")d in '${CONFIG_FILE}'."
        if $now; then
            if $enable; then
                cmd_start "$target"
            elif is_running "$target"; then
                stop_service_by_name "$target"
            fi
        fi
        return 0
    fi

    mv "$temp_file" "$CONFIG_FILE"
    invalidate_services
    log_success "${action^}d service '$target' in ${CONFIG_FILE}."
    log_event "OK" "${action^}d service '$target' in ${CONFIG_FILE}."

    if $now; then
        if $enable; then
            log_info "Starting service '$target' (--now)..."
            cmd_start "$target"
        elif is_running "$target"; then
            log_info "Stopping active service '$target' (--now)..."
            stop_service_by_name "$target"
        else
            log_info "Service '$target' is not currently running."
        fi
    fi
}

# Command: Attach to screen session
cmd_attach() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Please specify the service shortname to attach to!"
        log_info "Example: scmn attach webserver"
        exit 1
    fi

    if ! is_running "$target"; then
        log_error "No active screen session found for service '$target'."
        exit 1
    fi

    exec screen -r "$target"
}

# Command: Send input / command directly to service stdin
cmd_send() {
    local target="${1:-}"
    shift || true
    local text="$*"

    if [[ -z "$target" || -z "$text" ]]; then
        log_error "Usage: scmn send <shortname> \"<command/text>\""
        log_info "Example: scmn send mc_server \"say Server restarting soon\""
        exit 1
    fi

    if ! is_running "$target"; then
        log_error "Service '$target' is not running."
        exit 1
    fi

    screen -S "$target" -X stuff "${text}$(printf '\r')"
    log_success "Sent input to service '$target': $text"
    log_event "INFO" "Sent input to service '$target': $text"
}

# Command: Stop a service or all services
cmd_stop() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Specify service shortname to stop, or '--all' to stop all."
        exit 1
    fi

    if [[ "$target" == "--all" ]]; then
        local stopped_any=false
        stop_all_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            if is_running "$name"; then
                stopped_any=true
                stop_service_by_name "$name" "$cmd"
            elif cmd_is_docker "$cmd" && docker_any_container_running "$cmd" "$name"; then
                stopped_any=true
                stop_service_by_name "$name" "$cmd"
            fi
        }
        parse_config stop_all_callback "true"

        if ! $stopped_any; then
            log_info "No active services to stop."
        fi
    else
        stop_service_by_name "$target"
    fi
}

# Command: Restart service(s)
cmd_restart() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Specify service shortname to restart, or '--all'."
        exit 1
    fi

    if [[ "$target" == "--all" ]]; then
        cmd_stop "--all"
        sleep 0.5
        cmd_start
    else
        local found=false
        restart_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"
            local env_vars="$5"
            local auto_restart="$6"
            local is_disabled="${7:-false}"

            if [[ "$name" == "$target" ]]; then
                found=true
                if [[ "$is_disabled" == "true" ]]; then
                    log_warn "Service '$target' is disabled in configuration. Use 'scmn enable $target --now' to enable and restart it."
                    if is_running "$target"; then
                        stop_service_by_name "$target" "$cmd"
                    fi
                    return 0
                fi
                cmd_stop "$target"
                sleep 0.5
                start_service "$name" "$dir" "$cmd" "$logfile" "$env_vars" "$auto_restart"
            fi
        }
        parse_config restart_callback "true"

        if ! $found; then
            log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
            exit 1
        fi
    fi
}

# Command: Synchronize running services with configuration file
cmd_reload() {
    ensure_config
    log_info "Using configuration: ${CONFIG_FILE}"
    log_info "Synchronizing services with configuration..."
    echo

    local -A configured_enabled=()
    local -A configured_disabled=()
    local -A service_dir=()
    local -A service_cmd=()
    local -A service_log=()
    local -A service_env=()
    local -A service_restart=()

    collect_services_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"
        local env_vars="$5"
        local auto_restart="$6"
        local is_disabled="${7:-false}"

        service_dir["$name"]="$dir"
        service_cmd["$name"]="$cmd"
        service_log["$name"]="$logfile"
        service_env["$name"]="$env_vars"
        service_restart["$name"]="$auto_restart"

        if [[ "$is_disabled" == "true" ]]; then
            configured_disabled["$name"]=1
        else
            configured_enabled["$name"]=1
        fi
    }

    parse_config collect_services_callback "true"

    local statedir
    statedir=$(get_state_dir)

    local stopped_count=0
    local restarted_count=0
    local started_count=0
    local unchanged_count=0

    # Step 1: Check running services
    for name in "${!service_cmd[@]}"; do
        if is_running "$name"; then
            if [[ -n "${configured_disabled[$name]:-}" ]]; then
                log_info "Stopping disabled service '$name'..."
                stop_service_by_name "$name"
                stopped_count=$((stopped_count + 1))
            elif [[ -n "${configured_enabled[$name]:-}" ]]; then
                local current_sig="${service_dir[$name]}|${service_cmd[$name]}|${service_log[$name]}|${service_env[$name]}|${service_restart[$name]}"
                local state_file="$statedir/$name.state"
                local old_sig=""
                if [[ -f "$state_file" ]]; then
                    old_sig=$(cat "$state_file" 2>/dev/null || true)
                fi

                if [[ -n "$old_sig" && "$old_sig" == "$current_sig" ]]; then
                    log_info "Service '$name' is up-to-date and running."
                    unchanged_count=$((unchanged_count + 1))
                else
                    log_info "Configuration changed for '$name'. Restarting..."
                    stop_service_by_name "$name"
                    sleep 0.3
                    start_service "$name" "${service_dir[$name]}" "${service_cmd[$name]}" "${service_log[$name]}" "${service_env[$name]}" "${service_restart[$name]}"
                    restarted_count=$((restarted_count + 1))
                fi
            fi
        fi
    done

    # Step 2: Start enabled services that are not running
    for name in "${!configured_enabled[@]}"; do
        local state_of
        state_of=$(get_service_state "$name" "${service_cmd[$name]:-}")
        if [[ "$state_of" == "STOPPED" || -z "$state_of" ]]; then
            log_info "Starting missing service '$name'..."
            start_service "$name" "${service_dir[$name]}" "${service_cmd[$name]}" "${service_log[$name]}" "${service_env[$name]}" "${service_restart[$name]}"
            started_count=$((started_count + 1))
        elif [[ "$state_of" == "RUNNING" || "$state_of" == "ORPHANED" ]]; then
            log_info "Service '$name' is already running (state: $state_of)."
            unchanged_count=$((unchanged_count + 1))
        else
            log_info "Service '$name' is '${state_of}'. Skipping."
        fi
    done

    echo
    log_info "Checking log file sizes (Limit: ${MAX_LOG_SIZE_MB}MB)..."
    check_logs_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        truncate_log_if_needed "$name" "$logfile"
    }
    parse_config check_logs_callback

    echo
    log_success "Reload completed (Started: $started_count, Restarted: $restarted_count, Stopped: $stopped_count, Unchanged: $unchanged_count)."
    log_event "OK" "Reloaded configuration from ${CONFIG_FILE} (Started: $started_count, Restarted: $restarted_count, Stopped: $stopped_count, Unchanged: $unchanged_count)."
}

# Command: Validate configuration file syntax and definitions
cmd_check() {
    ensure_config
    log_info "Checking configuration file: ${CONFIG_FILE}"
    echo

    local errors=()
    local warnings=()
    local enabled_count=0
    local disabled_count=0
    local -A seen_names=()
    local -A seen_lines=()

    local line_num=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_num=$((line_num + 1))

        local trimmed
        trimmed="$(trim "$line")"

        if [[ -z "$trimmed" ]]; then
            continue
        fi

        local is_comment=false
        if [[ "$trimmed" =~ ^# ]]; then
            is_comment=true
        fi

        local parse_line="$trimmed"
        local is_disabled=false
        if $is_comment; then
            parse_line="$(trim "${trimmed#\#}")"
            is_disabled=true
        fi

        # Skip comments without pipe delimiter
        if [[ "$parse_line" != *"|"* ]]; then
            continue
        fi

        local name="" dir="" cmd="" logfile="" env_vars="" auto_restart=""
        IFS='|' read -r name dir cmd logfile env_vars auto_restart <<< "$parse_line"

        name="$(trim "${name:-}")"
        dir="$(trim "${dir:-}")"
        cmd="$(trim "${cmd:-}")"
        logfile="$(trim "${logfile:-}")"
        env_vars="$(trim "${env_vars:-}")"
        auto_restart="$(trim "${auto_restart:-}")"

        # Ignore known header comments
        if [[ "$name" =~ ^(shortname|Format|Format:|Rules:|Rules)$ ]]; then
            continue
        fi

        if $is_comment && [[ ! "$name" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
            continue
        fi

        # Shortname syntax check
        if [[ -z "$name" ]]; then
            errors+=("Line $line_num: Missing service shortname.")
            continue
        fi

        if [[ ! "$name" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
            errors+=("Line $line_num: Invalid shortname '$name'. Must contain only letters, numbers, underscores, dots, or hyphens.")
        fi

        # Duplicate shortname check
        if [[ -n "${seen_names[$name]:-}" ]]; then
            errors+=("Line $line_num: Duplicate service shortname '$name' (previously defined on line ${seen_lines[$name]}).")
        else
            seen_names["$name"]=1
            seen_lines["$name"]=$line_num
        fi

        if $is_disabled; then
            disabled_count=$((disabled_count + 1))
        else
            enabled_count=$((enabled_count + 1))
        fi

        # Command check
        if [[ -z "$cmd" ]]; then
            errors+=("Line $line_num: Service '$name' is missing a command.")
        else
            local primary_bin
            primary_bin=$(echo "$cmd" | awk '{print $1}')
            if [[ -n "$primary_bin" ]]; then
                if [[ "$primary_bin" == ./* || "$primary_bin" == /* ]]; then
                    if [[ ! -e "$primary_bin" ]]; then
                        warnings+=("Line $line_num: Executable '$primary_bin' for service '$name' not found on disk.")
                    fi
                elif ! command -v "$primary_bin" >/dev/null 2>&1; then
                    if ! type "$primary_bin" >/dev/null 2>&1; then
                        warnings+=("Line $line_num: Command '$primary_bin' for service '$name' not found in PATH.")
                    fi
                fi
            fi

            # Docker check: label is always injected; a deterministic --name is
            # injected when none is given.
            if cmd_is_docker "$cmd"; then
                local docker_name_hint docker_label_hint
                docker_name_hint=$(docker_service_name "$name")
                docker_label_hint=$(docker_label_value "$name")
                if ! docker_cmd_has_name "$cmd"; then
                    warnings+=("Line $line_num: Service '$name' uses 'docker run' without '--name'. scmn will inject '--name $docker_name_hint' and '--label $docker_label_hint'. An explicit '--name' is recommended.")
                fi
                # auto_restart is ignored for docker; the engine handles restarts.
                if [[ -n "$(normalize_restart "$auto_restart")" && "$(normalize_restart "$auto_restart")" != "never" ]]; then
                    warnings+=("Line $line_num: Service '$name' is Docker-based; scmn ignores auto_restart='$auto_restart'. Use the Docker --restart policy to control restarts.")
                fi
            fi
        fi

        # Directory check
        if [[ -n "$dir" && "$dir" != "-" ]]; then
            if [[ ! -d "$dir" ]]; then
                warnings+=("Line $line_num: Working directory '$dir' for service '$name' does not exist.")
            fi
        fi

        # Logfile check
        if [[ -n "$logfile" && "$logfile" != "none" && "$logfile" != "off" && "$logfile" != "-" ]]; then
            local logdir
            logdir=$(dirname "$logfile")
            if [[ ! -d "$logdir" ]]; then
                if ! mkdir -p "$logdir" 2>/dev/null; then
                    warnings+=("Line $line_num: Log directory '$logdir' for service '$name' does not exist and cannot be created.")
                fi
            fi
        fi

        # Auto-restart policy check
        if [[ -n "$auto_restart" && "$auto_restart" != "-" ]]; then
            if ! normalize_restart "$auto_restart" >/dev/null 2>&1; then
                warnings+=("Line $line_num: Unknown auto_restart policy '$auto_restart' for service '$name' (defaults to 'never').")
            fi
        fi

    done < "$CONFIG_FILE"

    # Display results
    if (( ${#errors[@]} > 0 )); then
        for err in "${errors[@]}"; do
            log_error "$err"
        done
    fi

    if (( ${#warnings[@]} > 0 )); then
        for warn in "${warnings[@]}"; do
            log_warn "$warn"
        done
    fi

    echo
    if (( ${#errors[@]} > 0 )); then
        log_error "Configuration check FAILED with ${#errors[@]} error(s) and ${#warnings[@]} warning(s)."
        return 1
    elif (( ${#warnings[@]} > 0 )); then
        log_warn "Configuration check PASSED with ${#warnings[@]} warning(s) ($enabled_count enabled, $disabled_count disabled service(s))."
        return 0
    else
        log_success "Configuration syntax is valid ($enabled_count enabled, $disabled_count disabled service(s))."
        return 0
    fi
}

# Command: Clear log file for a service, all services (--all), or scmn manager log (default)
cmd_log_clear() {
    local target="${1:-}"

    # Case 1: No target specified -> clear manager central log
    if [[ -z "$target" ]]; then
        local manager_log="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"
        if [[ ! -f "$manager_log" ]]; then
            log_info "Manager log file '$manager_log' does not exist yet (nothing to clear)."
            return 0
        fi

        : > "$manager_log" 2>/dev/null || true
        log_success "Cleared scmn manager log ($manager_log)."
        log_event "OK" "Cleared scmn manager log ($manager_log)."
        return 0
    fi

    # Case 2: --all specified -> clear all service log files and manager log
    if [[ "$target" == "--all" ]]; then
        ensure_config
        local cleared_count=0
        local seen_logs=()

        clear_all_logs_callback() {
            local name="$1"
            local dir="$2"
            local cmd="$3"
            local logfile="$4"

            if [[ -n "$logfile" && "$logfile" != "none" && "$logfile" != "off" && "$logfile" != "-" ]]; then
                for seen in "${seen_logs[@]:-}"; do
                    if [[ "$seen" == "$logfile" ]]; then
                        return 0
                    fi
                done
                seen_logs+=("$logfile")

                if [[ -f "$logfile" ]]; then
                    : > "$logfile" 2>/dev/null || true
                    log_success "Cleared log for '$name' ($logfile)."
                    cleared_count=$((cleared_count + 1))
                fi
            fi
        }

        parse_config clear_all_logs_callback "true"

        local manager_log="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"
        if [[ -f "$manager_log" ]]; then
            : > "$manager_log" 2>/dev/null || true
            log_success "Cleared manager log ($manager_log)."
            cleared_count=$((cleared_count + 1))
        fi

        log_success "Cleared all log files ($cleared_count file(s))."
        log_event "OK" "Cleared all log files ($cleared_count file(s))."
        return 0
    fi

    # Case 3: Specific service shortname
    ensure_config
    local target_logfile=""
    local service_found=false

    find_target_logfile_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        if [[ "$name" == "$target" ]]; then
            service_found=true
            target_logfile="$logfile"
        fi
    }

    parse_config find_target_logfile_callback "true"

    if ! $service_found; then
        log_error "Service '$target' not found in configuration file '${CONFIG_FILE}'."
        exit 1
    fi

    if [[ -z "$target_logfile" || "$target_logfile" == "none" || "$target_logfile" == "off" || "$target_logfile" == "-" ]]; then
        log_warn "Service '$target' does not have a log file configured."
        return 0
    fi

    if [[ ! -f "$target_logfile" ]]; then
        log_info "Log file '$target_logfile' for service '$target' does not exist yet (nothing to clear)."
        return 0
    fi

    : > "$target_logfile" 2>/dev/null || true
    log_success "Cleared log file '$target_logfile' for service '$target'."
    log_event "OK" "Cleared log file '$target_logfile' for service '$target'."
}

## Command: View logs for a service or the manager log if shortname is omitted
cmd_log() {
    local first="${1:-}"

    if [[ "$first" == "clear" || "$first" == "--clear" ]]; then
        shift || true
        cmd_log_clear "${1:-}"
        return 0
    fi

    local target="${1:-}"
    local lines="${2:-50}"

    # If shortname is omitted, tail the manager's central log file
    if [[ -z "$target" ]]; then
        local manager_log="${SCMN_LOG:-$HOME/.config/scmn/scmn.log}"
        if [[ ! -f "$manager_log" ]]; then
            log_warn "Manager log file '$manager_log' does not exist yet (no events logged)."
            exit 0
        fi

        log_info "Showing last $lines lines from scmn log ($manager_log):"
        echo "--------------------------------------------------------------------------------"
        echo "Press Ctrl+C to exit the log view."
        tail -n "$lines" -f "$manager_log"
        return 0
    fi

    local target_logfile=""
    find_logfile_callback() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        local logfile="$4"

        if [[ "$name" == "$target" ]]; then
            target_logfile="$logfile"
        fi
    }
    parse_config find_logfile_callback "true"

    if [[ -z "$target_logfile" || "$target_logfile" == "none" || "$target_logfile" == "off" ]]; then
        log_error "Service '$target' does not have a log file configured."
        exit 1
    fi

    if [[ ! -f "$target_logfile" ]]; then
        log_warn "Log file '$target_logfile' does not exist yet (no logs written)."
        exit 1
    fi

    log_info "Showing the last $lines lines from $target_logfile:"
    echo "--------------------------------------------------------------------------------"
    echo "Press Ctrl+C to exit the log view."
    tail -n "$lines" -f "$target_logfile"
}

# Command: Cron job management (install/uninstall/status)
cmd_cron() {
    local subcmd="${1:-}"
    local script_path
    script_path=$(readlink -f "$0")

    local cron_comment="# scmn auto-check"
    local cron_schedule="*/15 * * * *"
    local cron_line="$cron_schedule SCMN_CONF=${CONFIG_FILE:-$HOME/.config/scmn/scmn.conf} $script_path start >/dev/null 2>&1 $cron_comment"

    case "$subcmd" in
        install)
            find_config || true
            local current_cron
            current_cron=$(crontab -l 2>/dev/null || true)

            if echo "$current_cron" | grep -q "$cron_comment"; then
                log_warn "scmn cron job is already installed."
                return 0
            fi

            (
                echo "$current_cron"
                echo "$cron_line"
            ) | crontab -

            log_success "Cron job installed! Runs every 15 minutes (*/15)."
            log_info "Generated crontab line:"
            echo "  $cron_line"
            ;;

        uninstall)
            local current_cron
            current_cron=$(crontab -l 2>/dev/null || true)

            if ! echo "$current_cron" | grep -q "$cron_comment"; then
                log_warn "No scmn cron job found in crontab."
                return 0
            fi

            echo "$current_cron" | grep -v "$cron_comment" | crontab -
            log_success "Cron job uninstalled."
            ;;

        status)
            local current_cron
            current_cron=$(crontab -l 2>/dev/null || true)

            if echo "$current_cron" | grep -q "$cron_comment"; then
                log_success "Cron job is ACTIVE."
                echo "$current_cron" | grep "$cron_comment"
            else
                log_warn "Cron job is NOT installed."
            fi
            ;;

        *)
            log_error "Unknown cron subcommand. Use: install, uninstall, or status."
            exit 1
            ;;
    esac
}

# Command: Docker container management (`scmn docker orphans [--clean]`)
cmd_docker() {
    local subcmd="${1:-}"

    case "$subcmd" in
        orphans|list)
            shift || true
            cmd_docker_orphans "$@"
            ;;
        *)
            log_error "Unknown docker subcommand '${subcmd:-}'. Available: orphans"
            exit 1
            ;;
    esac
}

# List (and optionally clean) running docker containers that scmn does not
# supervise: containers whose screen session is gone (ORPHANED) or containers
# that were never tracked by a label/known name (UNTRACKED).
cmd_docker_orphans() {
    local clean=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --clean|-c)
                clean="true"
                ;;
            *)
                log_error "Unknown option '$1'. Usage: scmn docker orphans [--clean]"
                return 1
                ;;
        esac
        shift
    done

    if ! command -v docker >/dev/null 2>&1; then
        log_error "Docker is not available on this system."
        return 1
    fi

    # Collect configured docker services: label value/name -> shortname
    local -A label_owner=()
    local -A name_owner=()
    collect_docker_orphans_cb() {
        local name="$1"
        local dir="$2"
        local cmd="$3"
        if cmd_is_docker "$cmd"; then
            label_owner["$name"]="$name"
            local cn
            while IFS= read -r cn; do
                [[ -n "$cn" ]] && name_owner["$cn"]="$name"
            done < <(docker_cmd_names "$cmd" "$name")
        fi
    }

    if find_config; then
        parse_config collect_docker_orphans_cb "true"
    else
        log_info "No configuration file found; scanning conventions only (scmn.service-labels and scmn_* names)."
    fi

    echo
    log_info "Scanning running Docker containers..."
    echo "--------------------------------------------------------------------------------"
    printf "${BOLD}%-20s %-10s %-9s %-24s %s${NC}\n" "NAME" "STATUS" "CONTAINER" "IMAGE" "NOTE"
    printf "%s\n" "--------------------------------------------------------------------------------"

    local -a orphan_ids=()
    local -a untracked=()
    local orphan_count=0 untracked_count=0 managed_count=0

    local rows
    rows=$(docker ps --format '{{.Names}}\t{{.ID}}\t{{.Label "scmn.service"}}\t{{.Image}}' 2>/dev/null)

    if [[ -z "$rows" ]]; then
        log_info "No running Docker containers."
        return 0
    fi

    # cut (unlike bash read with IFS) preserves empty tab-separated fields, so
    # containers without a label are parsed correctly.
    local row
    while IFS= read -r row; do
        [[ -n "$row" ]] || continue
        local cname cid label image
        cname=$(cut -d$'\t' -f1 <<<"$row")
        cid=$(cut -d$'\t' -f2 <<<"$row")
        label=$(cut -d$'\t' -f3 <<<"$row")
        image=$(cut -d$'\t' -f4 <<<"$row")
        [[ -n "$cid" ]] || continue

        if [[ -n "$label" ]]; then
            local owner
            owner="${label_owner[$label]:-}"
            if [[ -n "$owner" ]] && is_running "$owner"; then
                managed_count=$((managed_count + 1))
                printf "%-20s %b %-9s %-24s %s\n" "${cname:0:20}" "${CYAN}MANAGED${NC}   " "${cid:0:9}" "${image:0:24}" "service '$owner'"
                continue
            fi
            # Label present but no live session -> orphaned
            orphan_count=$((orphan_count + 1))
            orphan_ids+=("$cid")
            printf "%-20s %b %-9s %-24s %s\n" "${cname:0:20}" "${YELLOW}ORPHANED${NC}  " "${cid:0:9}" "${image:0:24}" "label ${label}"
        elif [[ "$cname" == scmn_* ]]; then
            # scmn-created container (convention) without a live session
            orphan_count=$((orphan_count + 1))
            orphan_ids+=("$cid")
            printf "%-20s %b %-9s %-24s %s\n" "${cname:0:20}" "${YELLOW}ORPHANED${NC}  " "${cid:0:9}" "${image:0:24}" "scmn-named, no session"
        elif [[ -n "${name_owner[$cname]:-}" ]]; then
            local owner2
            owner2="${name_owner[$cname]}"
            if is_running "$owner2"; then
                managed_count=$((managed_count + 1))
                printf "%-20s %b %-9s %-24s %s\n" "${cname:0:20}" "${CYAN}MANAGED${NC}   " "${cid:0:9}" "${image:0:24}" "service '$owner2'"
            else
                orphan_count=$((orphan_count + 1))
                orphan_ids+=("$cid")
                printf "%-20s %b %-9s %-24s %s\n" "${cname:0:20}" "${YELLOW}ORPHANED${NC}  " "${cid:0:9}" "${image:0:24}" "service '$owner2'"
            fi
        else
            untracked_count=$((untracked_count + 1))
            untracked+=("$cid|$cname")
            local inote="${image:-unknown image}"
            printf "%-20s %b %-9s %-24s %s\n" "${cname:0:20}" "${GRAY}UNTRACKED${NC} " "${cid:0:9}" "${inote:0:24}" "no scmn label"
        fi
    done < <(printf "%s\n" "$rows")

    echo "--------------------------------------------------------------------------------"
    log_info "Summary: ${CYAN}${managed_count}${NC} managed, ${YELLOW}${orphan_count}${NC} orphaned, ${GRAY}${untracked_count}${NC} untracked."

    if (( orphan_count == 0 && untracked_count == 0 )); then
        log_info "Nothing to clean."
        return 0
    fi

    if [[ -z "$clean" ]]; then
        log_warn "Orphaned containers are left running. Re-run with '--clean' to stop/remove ORPHANED containers."
        log_info "UNTRACKED containers are never removed automatically."
        return 0
    fi

    # Cleanup: stop + remove ORPHANED containers owned by scmn.
    local cid
    for cid in "${orphan_ids[@]:-}"; do
        [[ -n "$cid" ]] || continue
        docker stop "$cid" >/dev/null 2>&1 || true
        docker rm -f "$cid" >/dev/null 2>&1 || true
        log_success "Removed orphaned Docker container '$cid'."
    done

    # UNTRACKED containers: ask before touching (they may be unrelated).
    local entry
    for entry in "${untracked[@]:-}"; do
        [[ -n "$entry" ]] || continue
        local ucid uname
        ucid="${entry%%|*}"
        uname="${entry#*|}"
        read -r -p "Stop & remove untracked container '$uname' ($ucid)? [y/N] " ans
        if [[ "$ans" == "y" || "$ans" == "Y" ]]; then
            docker stop "$ucid" >/dev/null 2>&1 || true
            docker rm -f "$ucid" >/dev/null 2>&1 || true
            log_success "Removed untracked Docker container '$uname'."
        else
            log_info "Kept untracked container '$uname'."
        fi
    done
}

show_help() {
    echo -e "${BOLD}scmn ${VERSION} - Simple Screen Service Manager${NC}"
    echo
    echo -e "${BOLD}USAGE:${NC}"
    echo "  scmn [-c /path/to/file.conf] [command] [arguments]"
    echo
    echo -e "${BOLD}OPTIONS:${NC}"
    echo "  -c, --config <file>            Use specific configuration file path"
    echo "  -h, --help                     Display this help message"
    echo "  -V, --version                  Display version information"
    echo
    echo -e "${BOLD}COMMANDS:${NC}"
    echo "  scmn [start] [shortname]       Starts missing services (or a specific service)"
    echo "  scmn status | ls               Lists all configured services with PID, RAM, Uptime"
    echo "  scmn status <shortname>        Detailed status for one service (screen + workload proc)"
    echo "  scmn reload                    Syncs running services with config (starts, stops, restarts)"
    echo "  scmn check                     Validates configuration file syntax and paths"
    echo "  scmn enable <shortname> [--now]  Enables service in config (uncomment) & optionally starts"
    echo "  scmn disable <shortname> [--now] Disables service in config (comment out) & optionally stops"
    echo "  scmn attach | a <shortname>    Attaches directly to selected service screen session"
    echo "  scmn send <shortname> <txt>    Sends input/command directly to service stdin"
    echo "  scmn stop <shortname|--all>    Stops one or all services (graceful + SIGKILL fallback)"
    echo "  scmn restart <shortname|--all> Restarts one or all services"
    echo "  scmn log [shortname] [lines]   Tails service log (or scmn log if shortname omitted)"
    echo "  scmn log clear [name|--all]    Clears service log, all logs (--all), or scmn manager log"
    echo "  scmn cron install              Installs cron job (runs 'scmn' every 15 minutes)"
    echo "  scmn cron uninstall            Removes cron job from crontab"
    echo "  scmn cron status               Displays status of the cron job"
    echo "  scmn docker orphans [--clean]  Lists/cleans orphaned docker containers"
    echo "  scmn version                   Displays version information"
    echo "  scmn help                      Displays this help message"
    echo
    echo -e "${BOLD}CONFIGURATION FILE:${NC}"
    echo "  Searches in: ./scmn.conf, ~/.config/scmn/scmn.conf, /etc/scmn/scmn.conf"
    echo "  Format:      shortname|directory|command|logfile|env|auto_restart"
    echo "  Example:"
    echo "    webserver|/var/www|python3 -m http.server \$PORT|/var/log/web.log|PORT=8080|true"
    echo "    discord_bot|/home/user/bot|node index.js|none|-|false"
    echo
}

# Main command router
main() {
    local custom_config=""

    # Parse options like -c / --config, -h / --help, -V / --version
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--config)
                if [[ -n "${2:-}" ]]; then
                    custom_config="$2"
                    shift 2
                else
                    log_error "Option '$1' requires a file path argument."
                    exit 1
                fi
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -V|--version)
                echo "scmn ${VERSION}"
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ -n "$custom_config" ]]; then
        if [[ ! -f "$custom_config" ]]; then
            log_error "Specified config file '$custom_config' does not exist!"
            exit 1
        fi
        CONFIG_FILE="$custom_config"
        # Insert custom config at top of lookup list
        DEFAULT_CONFIG_LOCATIONS=("$custom_config" "${DEFAULT_CONFIG_LOCATIONS[@]}")
    fi

    local cmd="${1:-start}"

    case "$cmd" in
        start)
            shift || true
            cmd_start "${1:-}"
            ;;
        status)
            shift || true
            if [[ -n "${1:-}" ]]; then
                cmd_status_detail "$1"
            else
                cmd_status
            fi
            ;;
        ls|list)
            cmd_status
            ;;
        reload)
            cmd_reload
            ;;
        check|test|lint)
            cmd_check
            ;;
        enable)
            shift
            cmd_enable "$@"
            ;;
        disable)
            shift
            cmd_disable "$@"
            ;;
        attach|a)
            shift
            cmd_attach "${1:-}" "$cmd"
            ;;
        send)
            shift
            cmd_send "$@"
            ;;
        stop)
            shift
            cmd_stop "${1:-}"
            ;;
        restart)
            shift
            cmd_restart "${1:-}"
            ;;
        log-clear|clear-log)
            shift
            cmd_log_clear "${1:-}"
            ;;
        log|logs)
            shift
            cmd_log "$@"
            ;;
        cron)
            shift
            cmd_cron "${1:-status}"
            ;;
        docker)
            shift
            cmd_docker "$@"
            ;;
        version|-V|--version)
            echo "scmn ${VERSION}"
            ;;
        --help|-h|help)
            show_help
            ;;
        *)
            log_error "Unknown command: $cmd"
            echo
            show_help
            exit 1
            ;;
    esac
}

main "$@"
